package @APP_PACKAGE@;

import android.content.Context;
import android.util.Log;

import java.io.ByteArrayOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.io.InputStream;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Locale;
import java.util.TimeZone;

/**
 * Licenca VIP do app (remove os anuncios).
 *
 * O arquivo e escrito pelo add-on ``service.smarted.bootstrap`` (Python) depois
 * de validar o codigo comprado no site:
 *
 *     <perfil>/.kodi/userdata/addon_data/service.smarted.bootstrap/vip.json
 *     {"ativo": true, "codigo": "XXXX-XXXX", "expira": "2027-01-31", "origem": "cakto"}
 *
 * Regras de leitura (o app nunca confia em nada alem do arquivo):
 *  - sem arquivo, ou "ativo" falso => anuncios ligados;
 *  - "expira" vazio => sem prazo; com data, precisa estar no futuro (UTC);
 *  - qualquer erro de leitura => anuncios ligados (falha segura).
 *
 * O arquivo fica no armazenamento do app (nao no .kodi em si), entao apagar o
 * perfil nao "ganha" a licenca de novo: o add-on regrava ao validar o codigo.
 */
public final class Licenca {

    private static final String TAG = "SmartAds";
    private static final String ARQUIVO = "vip.json";
    private static final String PASTA = "service.smarted.bootstrap";

    private Licenca() {
    }

    /** Caminho do arquivo de licenca dentro do perfil do Kodi. */
    public static File arquivo(Context contexto) {
        File home = contexto.getExternalFilesDir("");
        if (home == null) {
            home = contexto.getFilesDir();
        }
        if (home == null) {
            return null;
        }
        return new File(new File(new File(new File(home, ".kodi"), "userdata"),
                "addon_data"), PASTA + "/" + ARQUIVO);
    }

    /** true = VIP ativo e no prazo: nenhum anuncio deve ser exibido. */
    public static boolean ativa(Context contexto) {
        File arquivo = arquivo(contexto);
        if (arquivo == null || !arquivo.isFile() || arquivo.length() > 65536L) {
            return false;
        }
        String texto;
        try {
            texto = ler(arquivo);
        } catch (Exception erro) {
            Log.w(TAG, "Licenca: nao consegui ler " + ARQUIVO + " (" + erro.getClass().getSimpleName() + ")");
            return false;
        }
        boolean ativo = texto.matches("(?s).*\"ativo\"\\s*:\\s*true.*");
        if (!ativo) {
            return false;
        }
        String expira = valor(texto, "expira");
        if (expira.length() == 0) {
            Log.i(TAG, "Licenca: VIP ativo (sem prazo)");
            return true;
        }
        boolean vale = dentroDoPrazo(expira);
        Log.i(TAG, "Licenca: VIP ativo, expira " + expira + " => " + (vale ? "ok" : "vencido"));
        return vale;
    }

    /**
     * Rota de validacao do codigo no site (producao).
     *
     * O site e uma SPA: qualquer caminho desconhecido devolve HTML de 404, nao
     * JSON. Por isso tentamos as rotas candidatas em ordem e paramos na
     * primeira que responder JSON — assim a ativacao funciona sem precisar de
     * rebuild se a rota real for outra. Se existir
     * ``<files>/vip-endpoint.txt`` com uma URL, ela e tentada primeiro.
     */
    public static final String VALIDAR_URL = "https://smartedtv-vip.lovable.app/api/validar";

    public static final String[] VALIDAR_URIS = {
        VALIDAR_URL,
        "https://smartedtv-vip.lovable.app/api/validate",
        "https://smartedtv-vip.lovable.app/api/ativar",
        "https://smartedtv-vip.lovable.app/api/codigos/validar",
        "https://smartedtv-vip.lovable.app/functions/v1/validar-codigo",
    };

    /**
     * Edge Functions do Supabase do site (descobertas por ``Supabase``): é o
     * backend de verdade do painel — códigos de TESTE (10 minutos) e MENSAIS
     * (30 dias) saem de lá.
     */
    private static final String[] SUPABASE_FUNCOES = {
        "/functions/v1/validar-codigo",
        "/functions/v1/validar",
        "/functions/v1/ativar-codigo",
        "/functions/v1/ativa-codigo",
    };

    private static String ultimaRotaBoa;

    /** Última rota que respondeu JSON de verdade (memória entre aberturas). */
    private static final String ROTA_BOA = "vip-endpoint-ok.txt";

    /** Pasta do add-on dentro do perfil do Kodi (o add-on lê os mesmos arquivos). */
    public static File pastaAddon(Context contexto) {
        File home = contexto.getExternalFilesDir("");
        if (home == null) {
            home = contexto.getFilesDir();
        }
        if (home == null) {
            return null;
        }
        File pasta = new File(new File(new File(new File(home, ".kodi"), "userdata"),
                "addon_data"), PASTA);
        if (!pasta.isDirectory()) {
            pasta.mkdirs();
        }
        return pasta;
    }

    /**
     * Guarda a rota que funcionou: a próxima ativação já começa por ela (e o
     * add-on do Kodi aproveita o mesmo arquivo, sem redescobrir o backend).
     */
    private static void lembrarRota(Context contexto, String rota) {
        if (rota == null || !rota.startsWith("http")) {
            return;
        }
        ultimaRotaBoa = rota;
        File[] destinos = new File[]{rotaBoa(contexto),
                pastaAddon(contexto) == null ? null : new File(pastaAddon(contexto), ROTA_BOA)};
        for (int i = 0; i < destinos.length; i++) {
            if (destinos[i] == null) {
                continue;
            }
            java.io.FileWriter escritor = null;
            try {
                escritor = new java.io.FileWriter(destinos[i]);
                escritor.write(rota + "\n");
                escritor.flush();
            } catch (Exception erro) {
                Log.w(TAG, "Licenca: não consegui lembrar a rota (" + erro + ")");
            } finally {
                if (escritor != null) {
                    try {
                        escritor.close();
                    } catch (Exception ignorado) {
                        // nada a fazer
                    }
                }
            }
        }
    }

    private static File rotaBoa(Context contexto) {
        File base = contexto.getFilesDir();
        if (base == null) {
            base = contexto.getExternalFilesDir("");
        }
        return base == null ? null : new File(base, ROTA_BOA);
    }

    /**
     * Valida um codigo no site e, dando certo, grava a licenca.
     *
     * Roda em thread propria (chamador cuida disso): devolve null quando deu
     * certo e a mensagem de erro quando nao.
     */
    public static String validar(Context contexto, String codigo) {
        String limpo = codigo == null ? "" : codigo.trim().toUpperCase(Locale.ROOT);
        if (limpo.length() < 4) {
            return "Digite o código completo.";
        }
        String corpo = "{\"codigo\":\"" + escapar(limpo) + "\",\"app\":\"smartedtv\","
                + "\"device\":\"" + escapar(identificador(contexto)) + "\"}";

        boolean achouJson = false;
        boolean aceito = false;
        String resposta = "";
        String usada = "";
        // teto de tempo: antes a soma dos timeouts passava de 80 s e a tela
        // ficava "Validando..." (parecia travada). Passou do prazo, para.
        final long prazo = System.currentTimeMillis() + 15000L;

        for (String rota : rotas(contexto)) {
            if (System.currentTimeMillis() > prazo) {
                Log.w(TAG, "Licenca: prazo de validacao esgotado nas rotas do site");
                break;
            }
            try {
                resposta = post(rota, corpo, "");
            } catch (Exception erro) {
                Log.w(TAG, "Licenca: rota " + rota + " falhou ("
                        + erro.getClass().getSimpleName() + ")");
                continue;
            }
            if (!pareceJson(resposta)) {
                continue;                 // página 404 da SPA, não é API
            }
            achouJson = true;
            usada = rota;
            aceito = respostaAceita(resposta, false);
            if (aceito || respostaRecusa(resposta)) {
                break;
            }
        }

        // Supabase (Edge Function e tabela) — backend do site
        if (!aceito) {
            String[] projeto = null;
            try {
                projeto = Supabase.configuracao(contexto);
            } catch (Throwable erro) {
                Log.w(TAG, "Licenca: sem Supabase (" + erro + ")");
            }
            if (projeto != null) {
                String base = projeto[0];
                String chave = projeto[1];
                for (int i = 0; i < SUPABASE_FUNCOES.length; i++) {
                    if (System.currentTimeMillis() > prazo) {
                        Log.w(TAG, "Licenca: prazo esgotado nas funcoes do Supabase");
                        break;
                    }
                    String rota = base + SUPABASE_FUNCOES[i];
                    try {
                        String bruta = post(rota, corpo, chave);
                        if (!pareceJson(bruta)) {
                            continue;
                        }
                        achouJson = true;
                        usada = rota;
                        resposta = bruta;
                        aceito = respostaAceita(bruta, false);
                        if (aceito || respostaRecusa(bruta)) {
                            break;
                        }
                    } catch (Exception erro) {
                        Log.w(TAG, "Licenca: supabase " + rota + " falhou ("
                                + erro.getClass().getSimpleName() + ")");
                    }
                }
                if (!aceito && System.currentTimeMillis() < prazo) {
                    // tabela do painel: REST com filtro pelo código
                    String rota = base + "/rest/v1/codigos?codigo=eq."
                            + java.net.URLEncoder.encode(limpo) + "&select=*";
                    try {
                        String bruta = get(rota, chave);
                        if (pareceJson(bruta)) {
                            achouJson = true;
                            usada = rota;
                            resposta = bruta;
                            aceito = respostaAceita(bruta, true);
                        }
                    } catch (Exception erro) {
                        Log.w(TAG, "Licenca: tabela do Supabase falhou (" + erro + ")");
                    }
                }
            }
        }

        if (!achouJson) {
            Log.w(TAG, "Licenca: nenhuma rota de validação respondeu JSON");
            if (System.currentTimeMillis() >= prazo) {
                return "O servidor demorou para responder. Confira a internet e toque em Ativar de novo.";
            }
            return "Não consegui falar com o servidor de ativação. Tente de novo em instantes.";
        }
        if (!aceito) {
            String mensagem = valor(resposta, "mensagem");
            if (mensagem.length() == 0) {
                mensagem = valor(resposta, "message");
            }
            if (mensagem.length() == 0) {
                mensagem = valor(resposta, "error");
            }
            if (mensagem.length() == 0) {
                mensagem = valor(resposta, "detail");
            }
            return mensagem.length() > 0 ? mensagem : "Código não reconhecido.";
        }
        lembrarRota(contexto, usada);
        String expira = expiraDe(resposta);
        if (!gravar(contexto, limpo, expira)) {
            return "Licença validada, mas não consegui gravar no aparelho.";
        }
        Log.i(TAG, "Licenca: VIP ativado por " + usada + " ate "
                + (expira.length() == 0 ? "sem prazo" : expira));
        return null;
    }

    /** A resposta do site/edge/tabela vale como "ativo"? */
    private static boolean respostaAceita(String json, boolean tabela) {
        String texto = json == null ? "" : json;
        if (texto.matches("(?s).*\"(ativo|val[id]o|ok|success|valid|liberado)\"\\s*:\\s*true.*")) {
            return true;
        }
        if (texto.matches("(?s).*\"(status|situacao|estado)\"\\s*:\\s*\"(ativo|valido|liberado|ok)\""
                + ".*")) {
            return true;
        }
        if (texto.matches("(?s).*\"(usado|utilizado|resgatado)\"\\s*:\\s*false.*")) {
            return true;                  // linha da tabela ainda não usada
        }
        if (tabela && texto.trim().startsWith("[") && !texto.trim().equals("[]")) {
            // REST devolveu a linha do código
            return true;
        }
        return false;
    }

    /** Resposta explícita de recusa: para de tentar outras rotas. */
    private static boolean respostaRecusa(String json) {
        String texto = json == null ? "" : json;
        if (texto.matches("(?s).*\"(ativo|val[id]o|ok|success|valid)\"\\s*:\\s*false.*")) {
            return true;
        }
        return texto.matches("(?s).*\"(error|erro)\"\\s*:\\s*\"[^\"]+\".*")
                && !respostaAceita(texto, false);
    }

    /**
     * Prazo da licença a partir da resposta.
     *
     * Aceita, nesta ordem: data/hora explícita (``expira``, ``expira_em``,
     * ``expires_at``…), duração em minutos (código de TESTE, 10 min) ou em
     * dias (código MENSAL, 30 dias). Sem nada disso, assume 30 dias.
     */
    public static String expiraDe(String json) {
        for (String chave : new String[]{"expira", "expira_em", "expires", "expires_at",
                "validade", "data_expiracao", "expiration"}) {
            String bruto = valor(json, chave);
            if (bruto.length() > 0) {
                return normalizarPrazo(bruto);
            }
        }
        int minutos = numero(json, "minutos", "duracao_minutos", "validade_minutos",
                "duration_minutes");
        if (minutos > 0) {
            return emInstantes(minutos * 60L);
        }
        int dias = numero(json, "dias", "duracao_dias", "validade_dias", "duration_days");
        if (dias > 0) {
            return emInstantes(dias * 86400L);
        }
        String tipo = (valor(json, "tipo") + valor(json, "type") + valor(json, "plano")).toLowerCase(Locale.ROOT);
        if (tipo.contains("teste") || tipo.contains("trial") || tipo.contains("demo")
                || tipo.contains("10")) {
            return emInstantes(600L);     // código de teste: 10 minutos
        }
        return emInstantes(30L * 86400L); // código mensal: 30 dias
    }

    private static int numero(String json, String... chaves) {
        for (int i = 0; i < chaves.length; i++) {
            java.util.regex.Matcher m = java.util.regex.Pattern
                    .compile("\"" + chaves[i] + "\"\\s*:\\s*\"?([0-9]{1,6})\"?")
                    .matcher(json == null ? "" : json);
            if (m.find()) {
                try {
                    return Integer.parseInt(m.group(1));
                } catch (NumberFormatException ignorado) {
                    // tenta a próxima chave
                }
            }
        }
        return 0;
    }

    /** Data/hora UTC no formato do arquivo (yyyy-MM-dd'T'HH:mm:ss'Z'). */
    public static String emInstantes(long segundos) {
        SimpleDateFormat formato = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'", Locale.ROOT);
        formato.setTimeZone(TimeZone.getTimeZone("UTC"));
        return formato.format(new Date(System.currentTimeMillis() + segundos * 1000L));
    }

    /** Aceita "2027-01-31", "2027-01-31T10:00:00Z" e devolve ISO UTC. */
    private static String normalizarPrazo(String bruto) {
        String texto = bruto.trim().replace(" ", "T");
        if (texto.matches("\\d{4}-\\d{2}-\\d{2}")) {
            return texto + "T23:59:59Z";   // data cheia: vale até o fim do dia (UTC)
        }
        if (texto.length() == 10) {
            return texto + "T23:59:59Z";
        }
        if (texto.endsWith("Z") || texto.indexOf('+') > 10) {
            return texto;
        }
        return texto + "Z";
    }

    private static boolean pareceJson(String resposta) {
        if (resposta == null) {
            return false;
        }
        String limpo = resposta.trim();
        return limpo.startsWith("{") || limpo.startsWith("[");
    }

    /** Escreve o vip.json no perfil (mesmo formato que o addon do Kodi usa). */
    public static boolean gravar(Context contexto, String codigo, String expira) {
        File arquivo = arquivo(contexto);
        if (arquivo == null) {
            return false;
        }
        File pasta = arquivo.getParentFile();
        if (pasta != null && !pasta.isDirectory() && !pasta.mkdirs()) {
            Log.w(TAG, "Licenca: nao consegui criar " + pasta);
            return false;
        }
        String json = "{\n  \"ativo\": true,\n  \"codigo\": \"" + escapar(codigo)
                + "\",\n  \"expira\": \"" + escapar(expira)
                + "\",\n  \"origem\": \"app\"\n}\n";
        java.io.OutputStream saida = null;
        try {
            saida = new java.io.FileOutputStream(arquivo);
            saida.write(json.getBytes("UTF-8"));
            saida.flush();
            return true;
        } catch (Exception erro) {
            Log.w(TAG, "Licenca: nao consegui gravar vip.json (" + erro + ")");
            return false;
        } finally {
            if (saida != null) {
                try {
                    saida.close();
                } catch (Exception ignorado) {
                    // nada a fazer
                }
            }
        }
    }

    /** Rotas a tentar: arquivo de override (se existir) + candidatas. */
    public static String[] rotas(Context contexto) {
        java.util.ArrayList<String> lista = new java.util.ArrayList<String>();
        try {
            File home = contexto.getExternalFilesDir("");
            File extra = home == null ? null : new File(home, "vip-endpoint.txt");
            if (extra != null && extra.isFile() && extra.length() < 4096) {
                String texto = ler(extra).trim();
                if (texto.startsWith("http")) {
                    lista.add(texto);
                    Log.i(TAG, "Licenca: rota de override " + texto);
                }
            }
        } catch (Exception erro) {
            Log.w(TAG, "Licenca: sem vip-endpoint.txt (" + erro.getClass().getSimpleName() + ")");
        }
        // rota que já funcionou antes (Java e add-on gravam o mesmo arquivo)
        File pasta = pastaAddon(contexto);
        File[] conhecidas = new File[]{rotaBoa(contexto),
                pasta == null ? null : new File(pasta, ROTA_BOA)};
        for (int i = 0; i < conhecidas.length; i++) {
            if (conhecidas[i] == null || !conhecidas[i].isFile()
                    || conhecidas[i].length() > 4096) {
                continue;
            }
            try {
                String texto = ler(conhecidas[i]).trim();
                if (texto.startsWith("http") && !lista.contains(texto)) {
                    lista.add(texto);
                    ultimaRotaBoa = texto;
                    Log.i(TAG, "Licenca: rota que já funcionou " + texto);
                }
            } catch (Exception erro) {
                Log.w(TAG, "Licenca: sem " + ROTA_BOA + " (" + erro.getClass().getSimpleName() + ")");
            }
        }
        if (ultimaRotaBoa != null && !lista.contains(ultimaRotaBoa)) {
            lista.add(ultimaRotaBoa);
        }
        for (int i = 0; i < VALIDAR_URIS.length; i++) {
            if (!lista.contains(VALIDAR_URIS[i])) {
                lista.add(VALIDAR_URIS[i]);
            }
        }
        return lista.toArray(new String[0]);
    }

    private static String post(String url, String corpo, String chave) throws Exception {
        java.net.HttpURLConnection conexao =
                (java.net.HttpURLConnection) new java.net.URL(url).openConnection();
        conexao.setConnectTimeout(4000);
        conexao.setReadTimeout(12000);
        conexao.setRequestMethod("POST");
        conexao.setDoOutput(true);
        conexao.setRequestProperty("Content-Type", "application/json; charset=utf-8");
        conexao.setRequestProperty("Accept", "application/json");
        if (chave != null && chave.length() > 0) {
            // Supabase: a chave anon/public vai nos dois cabeçalhos que as
            // Edge Functions e o PostgREST esperam
            conexao.setRequestProperty("apikey", chave);
            conexao.setRequestProperty("Authorization", "Bearer " + chave);
        }
        java.io.OutputStream saida = conexao.getOutputStream();
        try {
            saida.write(corpo.getBytes("UTF-8"));
        } finally {
            saida.close();
        }
        int codigo = conexao.getResponseCode();
        java.io.InputStream fluxo = codigo >= 400 ? conexao.getErrorStream() : conexao.getInputStream();
        if (fluxo == null) {
            throw new java.io.IOException("HTTP " + codigo);
        }
        ByteArrayOutputStream acumulado = new ByteArrayOutputStream();
        byte[] buffer = new byte[4096];
        int lidos;
        while ((lidos = fluxo.read(buffer)) > 0) {
            acumulado.write(buffer, 0, lidos);
        }
        fluxo.close();
        return new String(acumulado.toByteArray(), "UTF-8");
    }

    /** GET (usado na tabela do Supabase). */
    private static String get(String url, String chave) throws Exception {
        java.net.HttpURLConnection conexao =
                (java.net.HttpURLConnection) new java.net.URL(url).openConnection();
        conexao.setConnectTimeout(4000);
        conexao.setReadTimeout(12000);
        conexao.setRequestMethod("GET");
        conexao.setRequestProperty("Accept", "application/json");
        if (chave != null && chave.length() > 0) {
            conexao.setRequestProperty("apikey", chave);
            conexao.setRequestProperty("Authorization", "Bearer " + chave);
        }
        int codigo = conexao.getResponseCode();
        java.io.InputStream fluxo = codigo >= 400 ? conexao.getErrorStream()
                : conexao.getInputStream();
        if (fluxo == null) {
            throw new java.io.IOException("HTTP " + codigo);
        }
        ByteArrayOutputStream acumulado = new ByteArrayOutputStream();
        byte[] buffer = new byte[4096];
        int lidos;
        while ((lidos = fluxo.read(buffer)) > 0) {
            acumulado.write(buffer, 0, lidos);
        }
        fluxo.close();
        return new String(acumulado.toByteArray(), "UTF-8");
    }

    private static String escapar(String texto) {
        return texto.replace("\\", "\\\\").replace("\"", "\\\"");
    }

    /** Identificacao curta do aparelho (sem dado sensivel). */
    private static String identificador(Context contexto) {
        String base = contexto.getPackageName() + "|" + android.os.Build.MODEL
                + "|" + android.os.Build.FINGERPRINT;
        try {
            java.security.MessageDigest digest = java.security.MessageDigest.getInstance("SHA-256");
            byte[] resumo = digest.digest(base.getBytes("UTF-8"));
            StringBuilder texto = new StringBuilder();
            for (int i = 0; i < 8; i++) {
                texto.append(String.format(Locale.ROOT, "%02x", resumo[i] & 255));
            }
            return texto.toString();
        } catch (Exception erro) {
            return "desconhecido";
        }
    }

    /** Codigo guardado no arquivo (vazio se nao houver). */
    public static String codigo(Context contexto) {
        File arquivo = arquivo(contexto);
        if (arquivo == null || !arquivo.isFile()) {
            return "";
        }
        try {
            return valor(ler(arquivo), "codigo");
        } catch (Exception erro) {
            return "";
        }
    }

    private static String valor(String json, String chave) {
        java.util.regex.Matcher m = java.util.regex.Pattern
                .compile("\"" + chave + "\"\\s*:\\s*\"([^\"]*)\"").matcher(json);
        return m.find() ? m.group(1).trim() : "";
    }

    /**
     * Prazo em dia (yyyy-MM-dd, vale até o fim do dia UTC) ou em data/hora
     * (yyyy-MM-dd'T'HH:mm:ss'Z', usado pelos códigos de teste de 10 minutos).
     */
    private static boolean dentroDoPrazo(String data) {
        String texto = data == null ? "" : data.trim();
        Date limite = null;
        try {
            if (texto.matches("\\d{4}-\\d{2}-\\d{2}")) {
                SimpleDateFormat dia = new SimpleDateFormat("yyyy-MM-dd", Locale.ROOT);
                dia.setTimeZone(TimeZone.getTimeZone("UTC"));
                dia.setLenient(false);
                Date base = dia.parse(texto);
                limite = base == null ? null : new Date(base.getTime() + 86399000L);
            } else {
                SimpleDateFormat completo = new SimpleDateFormat(
                        "yyyy-MM-dd'T'HH:mm:ss'Z'", Locale.ROOT);
                completo.setTimeZone(TimeZone.getTimeZone("UTC"));
                completo.setLenient(false);
                limite = completo.parse(texto.replace(" ", "T"));
            }
        } catch (Exception erro) {
            Log.w(TAG, "Licenca: prazo invalido (" + texto + ")");
            return false;
        }
        return limite != null && limite.getTime() >= System.currentTimeMillis();
    }

    private static String ler(File arquivo) throws Exception {
        InputStream entrada = new FileInputStream(arquivo);
        try {
            ByteArrayOutputStream saida = new ByteArrayOutputStream();
            byte[] buffer = new byte[4096];
            int lidos;
            while ((lidos = entrada.read(buffer)) > 0) {
                saida.write(buffer, 0, lidos);
            }
            return new String(saida.toByteArray(), "UTF-8");
        } finally {
            entrada.close();
        }
    }
}
