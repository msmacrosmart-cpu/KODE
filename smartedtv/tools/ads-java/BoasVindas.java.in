package @APP_PACKAGE@;

import android.app.Activity;
import android.content.Context;
import android.content.Intent;
import android.content.res.Configuration;
import android.graphics.Bitmap;
import android.graphics.BitmapFactory;
import android.graphics.Color;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.os.Handler;
import android.os.Looper;
import android.text.InputType;
import android.util.Log;
import android.util.TypedValue;
import android.view.Gravity;
import android.view.View;
import android.view.ViewGroup;
import android.view.inputmethod.EditorInfo;
import android.view.inputmethod.InputMethodManager;
import android.widget.Button;
import android.widget.EditText;
import android.widget.FrameLayout;
import android.widget.ImageView;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;

/**
 * Tela de ativação/compartilhamento, exibida na splash TODAS as vezes que o
 * app abre e SEMPRE antes de qualquer anúncio.
 *
 * Primeira abertura: pergunta se o aparelho é CELULAR ou TV/BOX/PROJETOR (a
 * escolha fica gravada por Plataforma).
 *
 *  * CELULAR — botões grandes: "Quero assistir sem anúncios" (checkout Cakto),
 *    "Compartilhar aplicativo" (Intent nativo do Android), campo de código,
 *    "Continuar com anúncios";
 *  * TV/BOX/PROJETOR — no topo, dois QR codes legíveis com título:
 *    "Escaneie e Compartilhe" (indicação do app) e
 *    "Escaneie e compre o acesso mensal" (checkout), seguidos do campo de
 *    código e dos botões.
 *
 * Layout: duas colunas quando a tela está deitada (TV, box, projetor, celular
 * deitado) e uma coluna em pé. Tudo nativo e sem barra de rolagem visível: a
 * tela cabe inteira; o toque rola apenas se o aparelho for muito pequeno.
 */
public final class BoasVindas {

    private static final String TAG = "SmartAds";
    public static final String CHECKOUT = "https://pay.cakto.com.br/nkvbegd_1323120";
    public static final String SITE = "https://smartedtv-vip.lovable.app/";
    /** QR de compartilhamento (indicação do app) empacotado no APK. */
    private static final String QR_APP = "addons/script.smartedtv.ajustes/resources/qrcode.png";
    /** QR do checkout mensal (Cakto). */
    private static final String QR_CAKTO =
            "addons/script.smartedtv.ajustes/resources/qrcode-cakto.png";

    private static volatile boolean aberta;
    /** Sem interação nenhuma, a tela se resolve sozinha (nunca trava o boot). */
    private static final long TEMPO_MAXIMO_TELA = 120000L;

    private BoasVindas() {
    }

    /** true = a tela foi montada (a splash NÃO deve abrir o Kodi ainda). */
    public static boolean mostrar(final Activity splash) {
        if (splash == null || aberta) {
            return false;
        }
        // VIP ATIVO (vip.json válido, do código de teste de 10 min ou do mensal
        // de 30 dias): a tela de ativação NUNCA aparece — o app abre direto no
        // conteúdo, limpo e sem anúncios.
        if (Licenca.ativa(splash)) {
            Log.i(TAG, "BoasVindas: VIP ativo, indo direto para o conteúdo");
            aberta = false;
            return false;
        }
        try {
            aberta = true;
            montar(splash);
            if (!montada(splash)) {
                // nada foi desenhado: melhor abrir o Kodi do que ficar na splash
                aberta = false;
                Log.w(TAG, "BoasVindas: tela nao ficou na arvore de views, abrindo o Kodi");
                return false;
            }
            vigiar(splash);
            return true;
        } catch (Throwable erro) {
            aberta = false;
            Log.w(TAG, "BoasVindas: nao consegui montar (" + erro + ")");
            return false;
        }
    }

    /** A tela realmente entrou na árvore de views? (sem view = splash travada) */
    private static boolean montada(Activity splash) {
        try {
            ViewGroup conteudo = squash(splash);
            return conteudo != null && conteudo.getChildCount() > 0;
        } catch (Throwable erro) {
            return false;
        }
    }

    private static ViewGroup squash(Activity splash) {
        View raiz = splash.findViewById(android.R.id.content);
        return raiz instanceof ViewGroup ? (ViewGroup) raiz : null;
    }

    /**
     * Cão de guarda do boot: se em 2 minutos a tela ainda estiver na frente e o
     * Kodi não tiver aberto (view travada, televisão sem controle na mão, toque
     * que não chegou), o app segue sozinho para o conteúdo. Antes disso, qualquer
     * travamento de layout deixava a splash na tela para sempre.
     */
    private static void vigiar(final Activity splash) {
        try {
            new Handler(Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override
                public void run() {
                    if (!aberta) {
                        return;
                    }
                    Log.w(TAG, "BoasVindas: 2 min sem concluir, abrindo o conteudo");
                    aberta = false;
                    SeedBase.iniciarKodi(splash);
                }
            }, TEMPO_MAXIMO_TELA);
        } catch (Throwable erro) {
            Log.w(TAG, "BoasVindas: sem cao de guarda (" + erro + ")");
        }
    }

    private static boolean largo(Activity activity) {
        try {
            Configuration cfg = activity.getResources().getConfiguration();
            if (cfg.orientation == Configuration.ORIENTATION_LANDSCAPE) {
                return true;
            }
            return activity.getResources().getDisplayMetrics().widthPixels
                    > activity.getResources().getDisplayMetrics().heightPixels;
        } catch (Exception erro) {
            return true;
        }
    }

    // --------------------------------------------------------------- montagem

    private static void montar(final Activity splash) {
        if (Plataforma.escolhida(splash).length() == 0) {
            escolherPlataforma(splash);
            return;
        }
        desenhar(splash);
    }

    /** Primeira abertura: CELULAR ou TV, com a sugestão do sistema marcada. */
    private static void escolherPlataforma(final Activity splash) {
        final boolean deitado = largo(splash);
        final String sugestao = Plataforma.detectar(splash);

        FrameLayout fundo = new FrameLayout(splash);
        fundo.setBackgroundColor(Color.rgb(8, 8, 10));

        LinearLayout raiz = coluna(splash);
        raiz.setPadding(dp(splash, 24), dp(splash, 24), dp(splash, 24), dp(splash, 24));

        raiz.addView(marca(splash));
        raiz.addView(titulo(splash, "Onde você está usando o app?", 30, true));
        raiz.addView(legenda(splash,
                "A TV mostra o QR code na tela; o celular compartilha pelo WhatsApp"
                        + " e abre o pagamento direto."));

        LinearLayout opcoes = new LinearLayout(splash);
        opcoes.setOrientation(deitado ? LinearLayout.HORIZONTAL : LinearLayout.VERTICAL);
        opcoes.setGravity(Gravity.CENTER);
        opcoes.setBaselineAligned(false);

        final Button celular = botao(splash, "Celular", false);
        final Button tv = botao(splash, "TV / Box / Projetor", false);
        opcoes.addView(opcao(splash, celular, Plataforma.CELULAR.equals(sugestao), deitado));
        opcoes.addView(opcao(splash, tv, Plataforma.TV.equals(sugestao), deitado));
        raiz.addView(opcoes, bloco(splash, deitado, 1f));

        final Button abrirAgora = botao(splash, "Abrir o SMARTEDTV agora", false);
        raiz.addView(abrirAgora, medir(splash, 320, 50, 20));

        rolar(splash, fundo, raiz);
        splash.setContentView(fundo);

        celular.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Plataforma.salvar(splash, Plataforma.CELULAR);
                desenhar(splash);
            }
        });
        tv.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Plataforma.salvar(splash, Plataforma.TV);
                desenhar(splash);
            }
        });
        abrirAgora.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                aberta = false;
                fundo.setVisibility(View.GONE);
                SeedBase.iniciarKodi(splash);
            }
        });

        if (Plataforma.TV.equals(sugestao)) {
            tv.requestFocus();
        } else {
            celular.requestFocus();
        }
        Log.i(TAG, "BoasVindas: escolha de plataforma (sugestao=" + sugestao + ")");
    }

    /** Botão de plataforma + selo "recomendado" (um bloco, sem sobreposição). */
    private static LinearLayout opcao(Activity splash, Button acao, boolean sugerido,
                                      boolean deitado) {
        LinearLayout bloco = new LinearLayout(splash);
        bloco.setOrientation(LinearLayout.VERTICAL);
        bloco.setGravity(Gravity.CENTER);
        bloco.addView(acao, medir(splash, deitado ? 300 : 320, 62, 0));
        if (sugerido) {
            TextView selo = legenda(splash, "recomendado para este aparelho");
            selo.setTextColor(Color.rgb(120, 200, 255));
            selo.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
            bloco.addView(selo);
        }
        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        p.rightMargin = dp(splash, deitado ? 24 : 0);
        p.bottomMargin = dp(splash, deitado ? 0 : 10);
        bloco.setLayoutParams(p);
        return bloco;
    }

    /** Tela principal: informação de um lado, ações do outro (ou empilhado). */
    private static void desenhar(final Activity splash) {
        final boolean vip = Licenca.ativa(splash);
        final boolean deitado = largo(splash);
        final boolean tv = Plataforma.eTV(splash);

        FrameLayout fundo = new FrameLayout(splash);
        fundo.setBackgroundColor(Color.rgb(8, 8, 10));

        LinearLayout raiz = new LinearLayout(splash);
        raiz.setOrientation(deitado ? LinearLayout.HORIZONTAL : LinearLayout.VERTICAL);
        raiz.setGravity(Gravity.CENTER);
        raiz.setBaselineAligned(false);
        int margem = dp(splash, deitado ? 40 : 22);
        raiz.setPadding(margem, dp(splash, 20), margem, dp(splash, 20));

        // ---- coluna da esquerda: marca, chamada e (na TV) UM QR code ---------
        LinearLayout esquerda = coluna(splash);
        esquerda.addView(marca(splash));
        esquerda.addView(titulo(splash, vip ? "Seu VIP está ativo" : "Deseja assistir sem anúncios?",
                28, true));
        esquerda.addView(legenda(splash, vip
                ? "Nenhum anúncio vai aparecer. Renove quando quiser, aqui do mesmo jeito."
                : (tv ? "Escaneie o código com o celular para compartilhar o app ou"
                        + " comprar o acesso mensal."
                      : "Toque em comprar para abrir o pagamento no celular.")));
        if (tv) {
            esquerda.addView(cartaoQr(splash, deitado));
        }

        // ---- coluna da direita: código e botões ------------------------------
        LinearLayout direita = acoes(splash, fundo, vip, tv, deitado);

        raiz.addView(esquerda, bloco(splash, deitado, 1f));
        raiz.addView(direita, bloco(splash, deitado, 1.1f));

        rolar(splash, fundo, raiz);
        splash.setContentView(fundo);
        Log.i(TAG, "BoasVindas: tela exibida (" + (deitado ? "deitada" : "em pe")
                + ", " + (tv ? "tv" : "celular") + ", vip=" + vip + ")");
    }

    /**
     * UM QR code por vez (na TV). Duas abas trocam o mesmo quadro: compartilhar
     * o app ou comprar o acesso mensal. Antes os dois QRs ficavam lado a lado e
     * não cabiam na tela.
     */
    private static LinearLayout cartaoQr(final Activity splash, boolean deitado) {
        LinearLayout cartao = coluna(splash);
        cartao.setBackground(placa(Color.rgb(17, 17, 21), Color.rgb(38, 38, 46)));
        cartao.setPadding(dp(splash, 14), dp(splash, 12), dp(splash, 14), dp(splash, 12));

        final ImageView qr = new ImageView(splash);
        final TextView dica = legenda(splash, "");
        final Button abaCompartilhar = botao(splash, "Escaneie e Compartilhe", false);
        final Button abaComprar = botao(splash, "Escaneie e compre o acesso mensal", true);
        abaCompartilhar.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
        abaComprar.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);

        LinearLayout abas = new LinearLayout(splash);
        abas.setOrientation(deitado ? LinearLayout.HORIZONTAL : LinearLayout.VERTICAL);
        abas.setGravity(Gravity.CENTER);
        abas.setBaselineAligned(false);
        abas.addView(abaCompartilhar, medir(splash, 236, 44, 4));
        abas.addView(abaComprar, medir(splash, 236, 44, 0));
        cartao.addView(abas);

        int lado = dp(splash, deitado ? 176 : 208);
        qr.setAdjustViewBounds(true);
        qr.setScaleType(ImageView.ScaleType.FIT_CENTER);
        qr.setContentDescription("QR code");
        LinearLayout.LayoutParams medidaQr = new LinearLayout.LayoutParams(lado, lado);
        medidaQr.topMargin = dp(splash, 10);
        medidaQr.bottomMargin = dp(splash, 8);
        cartao.addView(qr, medidaQr);

        dica.setGravity(Gravity.CENTER);
        dica.setMaxWidth(lado + dp(splash, 40));
        cartao.addView(dica);

        final Runnable mostrarApp = new Runnable() {
            @Override
            public void run() {
                mostrarQr(splash, qr, QR_APP);
                dica.setText("Aponte a câmera para baixar e compartilhar o app.");
            }
        };
        final Runnable mostrarCompra = new Runnable() {
            @Override
            public void run() {
                mostrarQr(splash, qr, QR_CAKTO);
                dica.setText("Aponte a câmera para comprar o acesso mensal (R$ 24,90).");
            }
        };

        abaCompartilhar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                mostrarApp.run();
            }
        });
        abaComprar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                mostrarCompra.run();
            }
        });

        mostrarCompra.run();          // começa pelo QR da compra
        abaComprar.requestFocus();
        return cartao;
    }

    private static void mostrarQr(Activity splash, ImageView qr, String caminho) {
        try {
            Bitmap imagem = imagemDoPacote(splash, caminho);
            if (imagem == null) {
                qr.setImageDrawable(null);
                Log.w(TAG, "BoasVindas: QR ausente no APK (" + caminho + ")");
                return;
            }
            qr.setImageBitmap(imagem);
        } catch (Throwable erro) {
            Log.w(TAG, "BoasVindas: QR nao carregou (" + erro + ")");
        }
    }

    /** Código de ativação + botões. Larguras relativas: nada se sobrepõe. */
    private static LinearLayout acoes(final Activity splash, final View fundo,
                                      final boolean vip, final boolean tv, boolean deitado) {
        LinearLayout coluna = coluna(splash);
        coluna.setGravity(Gravity.CENTER_HORIZONTAL);

        final Button comprar = botao(splash, vip ? "Renovar meu plano VIP"
                : "Quero assistir sem anúncios", true);
        coluna.addView(comprar, medir(splash, 0, deitado ? 58 : 56, 10));

        final Button compartilhar = botao(splash, "Compartilhar aplicativo", false);
        compartilhar.setVisibility(tv ? View.GONE : View.VISIBLE);
        coluna.addView(compartilhar, medir(splash, 0, 52, 8));

        TextView rotulo = legenda(splash, "Já tenho um código");
        rotulo.setPadding(0, dp(splash, 12), 0, dp(splash, 6));
        coluna.addView(rotulo);

        final EditText campo = new EditText(splash);
        campo.setHint("Digite o código aqui");
        campo.setTextColor(Color.WHITE);
        campo.setHintTextColor(Color.rgb(150, 150, 160));
        campo.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18);
        campo.setSingleLine(true);
        campo.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS);
        campo.setImeOptions(EditorInfo.IME_ACTION_DONE);
        campo.setGravity(Gravity.CENTER);
        campo.setBackground(caixa(splash, false));
        campo.setPadding(dp(splash, 14), dp(splash, 10), dp(splash, 14), dp(splash, 10));
        coluna.addView(campo, medir(splash, 0, 54, 6));

        final Button ativar = botao(splash, "Ativar agora", true);
        coluna.addView(ativar, medir(splash, 0, 56, 10));

        final TextView status = legenda(splash, "");
        status.setVisibility(View.GONE);
        coluna.addView(status);

        final Button continuar = botao(splash, vip ? "Entrar no SMARTEDTV"
                : "Continuar com anúncios", false);
        coluna.addView(continuar, medir(splash, 0, 54, 14));

        final Button trocarModo = botao(splash, tv ? "Estou no celular" : "Estou na TV", false);
        trocarModo.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
        coluna.addView(trocarModo, medir(splash, 240, 44, 10));

        abrirTecladoAoFocar(splash, campo);

        comprar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                abrir(splash, CHECKOUT);
            }
        });

        compartilhar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                BoasVindas.compartilhar(splash);
            }
        });

        ativar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                final String texto = campo.getText() == null ? "" : campo.getText().toString();
                if (texto.trim().length() < 4) {
                    campo.requestFocus();
                    teclado(splash, campo);
                    status.setVisibility(View.VISIBLE);
                    status.setTextColor(Color.rgb(210, 210, 220));
                    status.setText("Digite o código que você recebeu.");
                    return;
                }
                fecharTeclado(splash, campo);
                ativar.setEnabled(false);
                ativar.setText("Validando...");
                status.setVisibility(View.VISIBLE);
                status.setTextColor(Color.rgb(200, 200, 210));
                status.setText("Falando com o servidor de ativação...");
                new Thread(new Runnable() {
                    @Override
                    public void run() {
                        final String erro = Licenca.validar(splash, texto);
                        splash.runOnUiThread(new Runnable() {
                            @Override
                            public void run() {
                                ativar.setEnabled(true);
                                ativar.setText("Ativar agora");
                                if (erro == null) {
                                    status.setTextColor(Color.rgb(120, 220, 160));
                                    status.setText("VIP ativado! Nenhum anúncio nesta abertura.");
                                    comprar.setVisibility(View.GONE);
                                    continuar.setText("Entrar no SMARTEDTV");
                                    continuar.requestFocus();
                                } else {
                                    status.setTextColor(Color.rgb(235, 140, 140));
                                    status.setText(erro);
                                }
                            }
                        });
                    }
                }, "smarted-vip").start();
            }
        });

        continuar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                fecharTeclado(splash, campo);
                aberta = false;
                fundo.setVisibility(View.GONE);
                SeedBase.iniciarKodi(splash);
            }
        });

        trocarModo.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                boolean eraTV = Plataforma.eTV(splash);
                Plataforma.salvar(splash, eraTV ? Plataforma.CELULAR : Plataforma.TV);
                desenhar(splash);
            }
        });

        comprar.requestFocus();
        return coluna;
    }

    // ------------------------------------------------------------- peças de UI

    private static LinearLayout coluna(Context contexto) {
        LinearLayout coluna = new LinearLayout(contexto);
        coluna.setOrientation(LinearLayout.VERTICAL);
        coluna.setGravity(Gravity.CENTER_HORIZONTAL);
        coluna.setFocusable(false);
        return coluna;
    }

    private static TextView marca(Context contexto) {
        TextView marca = new TextView(contexto);
        marca.setText("SMARTEDTV");
        marca.setTextColor(Color.rgb(235, 235, 240));
        marca.setTextSize(TypedValue.COMPLEX_UNIT_SP, 17);
        marca.setLetterSpacing(0.30f);
        marca.setGravity(Gravity.CENTER);
        marca.setPadding(0, 0, 0, dp(contexto, 10));
        return marca;
    }

    private static TextView titulo(Context contexto, String texto, int tamanho, boolean negrito) {
        TextView titulo = new TextView(contexto);
        titulo.setText(texto);
        titulo.setTextColor(Color.WHITE);
        titulo.setTextSize(TypedValue.COMPLEX_UNIT_SP, tamanho);
        titulo.setGravity(Gravity.CENTER);
        if (negrito) {
            titulo.setTypeface(Typeface.DEFAULT_BOLD);
        }
        titulo.setPadding(0, 0, 0, dp(contexto, 8));
        return titulo;
    }

    private static TextView legenda(Context contexto, String texto) {
        TextView legenda = new TextView(contexto);
        legenda.setText(texto);
        legenda.setTextColor(Color.rgb(168, 168, 180));
        legenda.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
        legenda.setGravity(Gravity.CENTER);
        legenda.setPadding(0, 0, 0, dp(contexto, 6));
        return legenda;
    }

    /** Empilha (em pé) ou põe lado a lado (deitado) com peso — sem sobrepor. */
    private static LinearLayout.LayoutParams bloco(Context contexto, boolean deitado,
                                                   float peso) {
        if (!deitado) {
            LinearLayout.LayoutParams vertical = new LinearLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
            vertical.bottomMargin = dp(contexto, 10);
            return vertical;
        }
        LinearLayout.LayoutParams horizontal = new LinearLayout.LayoutParams(
                0, ViewGroup.LayoutParams.WRAP_CONTENT, peso);
        horizontal.rightMargin = dp(contexto, 24);
        return horizontal;
    }

    /** Medida de um botão: 0 = ocupa a largura da coluna. */
    private static LinearLayout.LayoutParams medir(Context contexto, int largura, int altura,
                                                   int margemAcima) {
        LinearLayout.LayoutParams medida = new LinearLayout.LayoutParams(
                largura <= 0 ? ViewGroup.LayoutParams.MATCH_PARENT : dp(contexto, largura),
                dp(contexto, altura));
        medida.topMargin = dp(contexto, margemAcima);
        return medida;
    }

    private static void rolar(Activity splash, View fundo, View conteudo) {
        ScrollView rolagem = new ScrollView(splash);
        rolagem.setFillViewport(true);
        rolagem.setVerticalScrollBarEnabled(false);
        rolagem.setHorizontalScrollBarEnabled(false);
        rolagem.setOverScrollMode(View.OVER_SCROLL_NEVER);
        rolagem.addView(conteudo, new ScrollView.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
        ((ViewGroup) fundo).addView(rolagem, new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
    }

    // -------------------------------------------------------------- utilidades

    /** Intent nativo de compartilhamento (WhatsApp, Telegram, e-mail...). */
    private static void compartilhar(Activity splash) {
        try {
            Intent enviar = new Intent(Intent.ACTION_SEND);
            enviar.setType("text/plain");
            enviar.putExtra(Intent.EXTRA_TEXT,
                    "Estou usando o SMARTEDTV e recomendo: " + SITE);
            enviar.putExtra(Intent.EXTRA_SUBJECT, "SMARTEDTV");
            splash.startActivity(Intent.createChooser(enviar, "Compartilhar aplicativo"));
            Log.i(TAG, "BoasVindas: compartilhamento nativo aberto");
        } catch (Exception erro) {
            Log.w(TAG, "BoasVindas: compartilhar falhou (" + erro + ")");
        }
    }

    private static void abrir(Activity splash, String url) {
        try {
            splash.startActivity(new Intent(Intent.ACTION_VIEW, android.net.Uri.parse(url)));
            Log.i(TAG, "BoasVindas: abrindo " + url);
        } catch (Exception erro) {
            Log.w(TAG, "BoasVindas: sem navegador para " + url);
        }
    }

    private static Bitmap imagemDoPacote(Context contexto, String caminho) {
        try {
            java.io.InputStream fluxo = contexto.getAssets().open(caminho);
            try {
                return BitmapFactory.decodeStream(fluxo);
            } finally {
                fluxo.close();
            }
        } catch (Throwable erro) {
            Log.w(TAG, "BoasVindas: imagem fora do pacote (" + caminho + ": " + erro + ")");
            return null;
        }
    }

    private static void abrirTecladoAoFocar(final Activity splash, final EditText campo) {
        campo.setOnFocusChangeListener(new View.OnFocusChangeListener() {
            @Override
            public void onFocusChange(View v, boolean temFoco) {
                if (temFoco) {
                    teclado(splash, campo);
                }
            }
        });
    }

    private static void teclado(Activity splash, EditText campo) {
        try {
            InputMethodManager ime = (InputMethodManager)
                    splash.getSystemService(Context.INPUT_METHOD_SERVICE);
            if (ime != null) {
                ime.showSoftInput(campo, InputMethodManager.SHOW_IMPLICIT);
            }
        } catch (Exception erro) {
            Log.w(TAG, "BoasVindas: teclado nao abriu (" + erro + ")");
        }
    }

    private static void fecharTeclado(Activity splash, EditText campo) {
        try {
            InputMethodManager ime = (InputMethodManager)
                    splash.getSystemService(Context.INPUT_METHOD_SERVICE);
            if (ime != null) {
                ime.hideSoftInputFromWindow(campo.getWindowToken(), 0);
            }
        } catch (Exception ignorado) {
            // sem teclado aberto
        }
    }

    private static int dp(Context contexto, int valor) {
        return (int) (valor * contexto.getResources().getDisplayMetrics().density);
    }

    private static LinearLayout.LayoutParams paramsLargura(Context contexto, int largura,
                                                           int altura) {
        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(
                Math.min(largura, contexto.getResources().getDisplayMetrics().widthPixels
                        - dp(contexto, 48)), dp(contexto, altura));
        p.topMargin = dp(contexto, 10);
        return p;
    }

    private static GradientDrawable caixa(Context contexto, boolean foco) {
        GradientDrawable forma = new GradientDrawable();
        forma.setCornerRadius(24f);
        forma.setColor(Color.rgb(26, 26, 32));
        forma.setStroke(2, foco ? Color.WHITE : Color.rgb(80, 80, 92));
        return forma;
    }

    private static GradientDrawable placa(int cor, int borda) {
        GradientDrawable forma = new GradientDrawable();
        forma.setCornerRadius(18f);
        forma.setColor(cor);
        forma.setStroke(2, borda);
        return forma;
    }

    private static Button botao(Context contexto, String texto, boolean destaque) {
        Button botao = new Button(contexto);
        aplicarFundo(botao, destaque, false);
        botao.setText(texto);
        botao.setTextSize(TypedValue.COMPLEX_UNIT_SP, 19);
        botao.setTextColor(destaque ? Color.rgb(10, 10, 10) : Color.WHITE);
        botao.setAllCaps(false);
        botao.setFocusable(true);
        botao.setFocusableInTouchMode(true);
        final boolean claro = destaque;
        botao.setOnFocusChangeListener(new View.OnFocusChangeListener() {
            @Override
            public void onFocusChange(View v, boolean temFoco) {
                aplicarFundo((Button) v, claro, temFoco);
                v.setScaleX(temFoco ? 1.04f : 1.0f);
                v.setScaleY(temFoco ? 1.04f : 1.0f);
            }
        });
        return botao;
    }

    private static void aplicarFundo(Button botao, boolean destaque, boolean foco) {
        GradientDrawable forma = new GradientDrawable();
        forma.setCornerRadius(32f);
        if (destaque) {
            forma.setColor(foco ? Color.rgb(255, 255, 255) : Color.rgb(238, 238, 244));
        } else {
            forma.setColor(foco ? Color.rgb(74, 74, 86) : Color.rgb(30, 30, 36));
            forma.setStroke(2, foco ? Color.WHITE : Color.rgb(74, 74, 86));
        }
        botao.setBackground(forma);
    }
}
