/**
 * Boas-vindas / ativação do SMARTEDTV — tela única, paisagem, monocromática.
 *
 * Espelha o blueprint aprovado (docs/boas-vindas-blueprint.html):
 *   cabeçalho ... logo do projeto + SMARTEDTV + seletor Android TV | Celular
 *   três colunas  boas-vindas | sem anúncios (QR) | indique e ganhe (QR)
 *   barra base .. "Já é assinante? Ative seu VIP" + campo + Ativar + Continuar
 *
 * Paleta: preto, branco e cinzas (nenhuma cor). Os dois QR ficam visíveis ao
 * mesmo tempo, cada um no seu cartão, em quadro branco quadrado e sem corte.
 * O desenho é proporcional a um quadro de 960x540 dp: cabe inteiro na tela,
 * sem rolagem, na TV 16:9 e no celular deitado.
 */
public final class BoasVindas {

    private static final String TAG = "SmartAds";

    public static final String CHECKOUT = "https://pay.cakto.com.br/nkvbegd_1323120";
    public static final String SITE = "https://smartedtv-vip.lovable.app/";

    private static final String QR_APP = "addons/script.smartedtv.ajustes/resources/qrcode.png";
    private static final String QR_CAKTO =
            "addons/script.smartedtv.ajustes/resources/qrcode-cakto.png";

    /** Quadro de referência do desenho (dp). */
    private static final float BASE_L = 960f;
    private static final float BASE_A = 540f;

    private static final int TINTA = 0xFFF7F7F7;
    private static final int TEXTO = 0xFFBCBCBC;
    private static final int APAGADO = 0xFF838383;
    private static final int BORDA = 0x1AFFFFFF;
    private static final int VIDRO_TOPO = 0x12FFFFFF;
    private static final int VIDRO_BASE = 0x05FFFFFF;

    /** Mensagens da ativação (uma constante por texto, para os testes acharem). */
    private static final String AVISO_VIP = "VIP ativado! Nenhum anúncio nesta abertura.";
    private static final String AVISO_CODIGO = "Digite o código que você recebeu.";

    private static volatile boolean aberta;
    private static final long TEMPO_MAXIMO_TELA = 120000L;

    private BoasVindas() {
    }

    /** true = a tela foi montada (a splash NÃO deve abrir o Kodi ainda). */
    public static boolean mostrar(final Activity splash) {
        if (splash == null || aberta) {
            return false;
        }
        if (Licenca.ativa(splash)) {
            Log.i(TAG, "BoasVindas: VIP ativo, indo direto para o conteúdo");
            aberta = false;
            return false;
        }
        paisagem(splash);
        try {
            aberta = true;
            if (Plataforma.escolhida(splash).length() == 0) {
                escolherPlataforma(splash);
            } else {
                desenhar(splash);
            }
            if (!montada(splash)) {
                aberta = false;
                Log.w(TAG, "BoasVindas: tela nao ficou na arvore de views, abrindo o Kodi");
                return false;
            }
            vigiar(splash);
            return true;
        } catch (Throwable erro) {
            aberta = false;
            Log.w(TAG, "BoasVindas: nao consegui montar (" + erro + ")");
            return false;
        }
    }

    private static void paisagem(Activity splash) {
        try {
            splash.setRequestedOrientation(ActivityInfo.SCREEN_ORIENTATION_SENSOR_LANDSCAPE);
        } catch (Throwable erro) {
            Log.w(TAG, "BoasVindas: sem travar paisagem (" + erro + ")");
        }
    }

    private static boolean montada(Activity splash) {
        try {
            View raiz = splash.findViewById(android.R.id.content);
            return raiz instanceof ViewGroup && ((ViewGroup) raiz).getChildCount() > 0;
        } catch (Throwable erro) {
            return false;
        }
    }

    private static void vigiar(final Activity splash) {
        try {
            new Handler(Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override
                public void run() {
                    if (!aberta) {
                        return;
                    }
                    Log.w(TAG, "BoasVindas: 2 min sem concluir, abrindo o conteudo");
                    aberta = false;
                    SeedBase.iniciarKodi(splash);
                }
            }, TEMPO_MAXIMO_TELA);
        } catch (Throwable erro) {
            Log.w(TAG, "BoasVindas: sem cao de guarda (" + erro + ")");
        }
    }

    // ---------------------------------------------------------------- telas

    /** Primeira abertura: "Como você vai assistir?" — mesma paleta da tela. */
    private static void escolherPlataforma(final Activity splash) {
        final Medidas m = new Medidas(splash);
        final String sugestao = Plataforma.detectar(splash);

        FrameLayout raiz = new FrameLayout(splash);
        fundo(m, raiz);
        raiz.addView(cabecalho(m, null), topo(m));

        LinearLayout centro = pilha(m);
        centro.setGravity(Gravity.CENTER);
        centro.addView(texto(m, "Como você vai assistir?", 30, Color.WHITE, true,
                Gravity.CENTER));
        centro.addView(texto(m, "Ajustamos a navegação ao seu aparelho."
                + " Você pode trocar quando quiser.", 12.5f, TEXTO, false, Gravity.CENTER),
                pilhaParams(m, 8));

        LinearLayout opcoes = new LinearLayout(splash);
        opcoes.setOrientation(LinearLayout.HORIZONTAL);
        opcoes.setGravity(Gravity.CENTER);
        opcoes.setBaselineAligned(false);

        final LinearLayout cartaoTv = cartaoEscolha(m, "Estou na TV",
                "Android TV, controle remoto");
        final LinearLayout cartaoCelular = cartaoEscolha(m, "Estou no Celular",
                "Navegação por toque na tela");
        opcoes.addView(cartaoTv, lp(m, 250, 120, 0, 0, 0));
        opcoes.addView(cartaoCelular, lp(m, 250, 120, 0, 14, 0));
        centro.addView(opcoes, pilhaParams(m, 12));

        raiz.addView(centro, new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT,
                Gravity.CENTER));

        Button abrirAgora = botao(m, "Abrir o SMARTEDTV agora", false, 12.5f, false);
        raiz.addView(abrirAgora, base(m, 230, 38));

        cartaoTv.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Plataforma.salvar(splash, Plataforma.TV);
                desenhar(splash);
            }
        });
        cartaoCelular.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Plataforma.salvar(splash, Plataforma.CELULAR);
                desenhar(splash);
            }
        });
        abrirAgora.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                aberta = false;
                SeedBase.iniciarKodi(splash);
            }
        });

        splash.setContentView(raiz);
        if (Plataforma.TV.equals(sugestao)) {
            cartaoTv.requestFocus();
        } else {
            cartaoCelular.requestFocus();
        }
        Log.i(TAG, "BoasVindas: escolha de plataforma (sugestao=" + sugestao + ")");
    }

    /** Tela principal: três colunas + barra de ativação. */
    private static void desenhar(final Activity splash) {
        final Medidas m = new Medidas(splash);
        final boolean vip = Licenca.ativa(splash);
        final boolean tv = Plataforma.eTV(splash);

        FrameLayout raiz = new FrameLayout(splash);
        fundo(m, raiz);

        LinearLayout tela = new LinearLayout(splash);
        tela.setOrientation(LinearLayout.VERTICAL);
        tela.setPadding(m.d(15), m.d(13), m.d(15), m.d(13));
        raiz.addView(tela, new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));

        tela.addView(cabecalho(m, new Modo() {
            @Override
            public void aoEscolher(boolean querTv) {
                Plataforma.salvar(splash, querTv ? Plataforma.TV : Plataforma.CELULAR);
                desenhar(splash);
            }
        }), lp(m, 0, 34, 0, 0, 0));

        LinearLayout colunas = new LinearLayout(splash);
        colunas.setOrientation(LinearLayout.HORIZONTAL);
        colunas.setBaselineAligned(false);
        colunas.addView(cartaoBoasVindas(m), lp(m, 0, 0, 1f, 0, 0));
        colunas.addView(cartaoAssinatura(m), lp(m, 0, 0, 1f, 11, 0));
        colunas.addView(cartaoIndicacao(m, tv), lp(m, 0, 0, 1f, 11, 0));
        tela.addView(colunas, lp(m, 0, 0, 1f, 0, 11));

        tela.addView(barraAtivacao(m, splash, vip), lp(m, 0, 0, 0, 0, 11));

        splash.setContentView(raiz);
        splash.getWindow().getDecorView().post(new Runnable() {
            @Override
            public void run() {
                View ativar = splash.findViewById(ID_ATIVAR);
                if (ativar != null) {
                    ativar.requestFocus();
                }
            }
        });
        Log.i(TAG, "BoasVindas: tela exibida (paisagem, " + (tv ? "tv" : "celular")
                + ", vip=" + vip + ", escala=" + m.escala + ")");
    }

    private static final int ID_ATIVAR = 0x53414431;

    // ------------------------------------------------------------- cartões

    private static LinearLayout cartaoBoasVindas(Medidas m) {
        LinearLayout cartao = cartao(m);

        LinearLayout linhaEyebrow = new LinearLayout(m.act);
        linhaEyebrow.setOrientation(LinearLayout.HORIZONTAL);
        linhaEyebrow.setGravity(Gravity.CENTER_VERTICAL);
        View traco = new View(m.act);
        traco.setBackground(m.traco());
        linhaEyebrow.addView(traco, lp(m, 16, 2, 0, 0, 0));
        TextView eyebrow = texto(m, "BEM-VINDO", 9.5f, APAGADO, true, Gravity.CENTER_VERTICAL);
        eyebrow.setLetterSpacing(0.22f);
        linhaEyebrow.addView(eyebrow, lp(m, -1, 0, 0, 7, 0));
        cartao.addView(linhaEyebrow);

        TextView titulo = texto(m, "Sua TV,\ndo seu jeito.", 27, Color.WHITE, true, Gravity.LEFT);
        titulo.setLineSpacing(m.d(1), 1f);
        cartao.addView(titulo, pilhaParams(m, 7));

        cartao.addView(texto(m, "Ative o VIP com um código ou continue gratuitamente"
                + " com anúncios.", 12, TEXTO, false, Gravity.LEFT), pilhaParams(m, 6));

        LinearLayout lista = pilha(m);
        lista.setGravity(Gravity.LEFT);
        lista.addView(item(m, "Canais ao vivo, sem travar"));
        lista.addView(item(m, "Sem anúncios com o VIP ativo"), pilhaParams(m, 6));
        lista.addView(item(m, "Ativação em poucos segundos"), pilhaParams(m, 6));
        cartao.addView(lista, lp(m, 0, 0, 1f, 0, 8));
        return cartao;
    }

    private static LinearLayout item(Medidas m, String descricao) {
        LinearLayout linha = new LinearLayout(m.act);
        linha.setOrientation(LinearLayout.HORIZONTAL);
        linha.setGravity(Gravity.CENTER_VERTICAL);
        TextView bolinha = texto(m, "✓", 9, Color.WHITE, true, Gravity.CENTER);
        bolinha.setBackground(m.bolinha());
        linha.addView(bolinha, lp(m, 14, 14, 0, 0, 0));
        linha.addView(texto(m, descricao, 11.5f, TEXTO, false, Gravity.CENTER_VERTICAL),
                lp(m, -1, 0, 0, 7, 0));
        return linha;
    }

    private static LinearLayout cartaoAssinatura(Medidas m) {
        LinearLayout cartao = cartao(m);
        cartao.addView(cabecalhoCartao(m, "Sem anúncios", "Plano mensal"));
        cartao.addView(quadroQr(m, QR_CAKTO), lp(m, 0, 0, 1f, 0, 6));
        cartao.addView(texto(m, "Aponte a câmera de outro celular.\n"
                + "Valor e condições no checkout.", 10.5f, APAGADO, false, Gravity.CENTER),
                pilhaParams(m, 4));
        Button abrir = botao(m, "Abrir checkout", false, 12, true);
        abrir.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                abrirLink(m.act, CHECKOUT);
            }
        });
        cartao.addView(abrir, lp(m, 0, 38, 0, 0, 6));
        return cartao;
    }

    private static LinearLayout cartaoIndicacao(Medidas m, boolean tv) {
        LinearLayout cartao = cartao(m);
        cartao.addView(cabecalhoCartao(m, "Indique e ganhe", "Compartilhar"));
        cartao.addView(quadroQr(m, QR_APP), lp(m, 0, 0, 1f, 0, 6));
        cartao.addView(texto(m, "Aponte a câmera e envie o link\ndo app a quem quiser.",
                10.5f, APAGADO, false, Gravity.CENTER), pilhaParams(m, 4));
        Button compartilhar = botao(m, "Compartilhar link", false, 12, true);
        compartilhar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                compartilhar(m.act);
            }
        });
        compartilhar.setVisibility(tv ? View.GONE : View.VISIBLE);
        cartao.addView(compartilhar, lp(m, 0, 38, 0, 0, 6));
        if (tv) {
            cartao.addView(texto(m, "smartedtv-vip.lovable.app", 10.5f, APAGADO, false,
                    Gravity.CENTER), pilhaParams(m, 3));
        }
        return cartao;
    }

    private static View cabecalhoCartao(Medidas m, String titulo, String selo) {
        LinearLayout linha = new LinearLayout(m.act);
        linha.setOrientation(LinearLayout.HORIZONTAL);
        linha.setGravity(Gravity.CENTER_VERTICAL);
        TextView nome = texto(m, titulo, 17, Color.WHITE, true, Gravity.CENTER_VERTICAL);
        linha.addView(nome, lp(m, 0, 0, 1f, 0, 0));
        TextView chip = texto(m, selo, 9.5f, TEXTO, false, Gravity.CENTER);
        chip.setBackground(m.chip());
        chip.setPadding(m.d(7), m.d(3), m.d(7), m.d(3));
        linha.addView(chip);
        return linha;
    }

    /** Quadro branco quadrado com o QR inteiro dentro (sem corte nem máscara). */
    private static LinearLayout quadroQr(Medidas m, String caminho) {
        LinearLayout moldura = pilha(m);
        moldura.setGravity(Gravity.CENTER);

        FrameLayout placa = new FrameLayout(m.act);
        GradientDrawable fundoPlaca = new GradientDrawable();
        fundoPlaca.setColor(Color.WHITE);
        fundoPlaca.setCornerRadius(m.d(6));
        placa.setBackground(fundoPlaca);

        ImageView qr = new ImageView(m.act);
        qr.setScaleType(ImageView.ScaleType.FIT_CENTER);
        Bitmap imagem = lerImagem(m.act, caminho);
        if (imagem != null) {
            qr.setImageBitmap(imagem);
        } else {
            Log.w(TAG, "BoasVindas: QR ausente no APK (" + caminho + ")");
        }
        int margem = m.d(6);
        FrameLayout.LayoutParams dentro = new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT);
        dentro.setMargins(margem, margem, margem, margem);
        placa.addView(qr, dentro);

        moldura.addView(placa, lp(m, 168, 168, 0, 0, 0));
        return moldura;
    }

    // --------------------------------------------------------- barra base

    private static View barraAtivacao(final Medidas m, final Activity splash, boolean vip) {
        LinearLayout barra = new LinearLayout(m.act);
        barra.setOrientation(LinearLayout.HORIZONTAL);
        barra.setGravity(Gravity.CENTER_VERTICAL);
        barra.setBackground(m.vidroForte());
        barra.setPadding(m.d(12), m.d(10), m.d(12), m.d(10));

        LinearLayout copia = pilha(m);
        copia.setGravity(Gravity.LEFT);
        copia.addView(texto(m, "Já é assinante? Ative seu VIP", 15, Color.WHITE, true, Gravity.LEFT));
        copia.addView(texto(m, "Digite o código que você recebeu.", 10.5f, APAGADO, false,
                Gravity.LEFT), pilhaParams(m, 3));
        barra.addView(copia);

        final EditText campo = campoCodigo(m);
        final Button ativar = botao(m, "Ativar", true, 12.5f, false);
        ativar.setId(ID_ATIVAR);

        final TextView status = texto(m, "", 10.5f, APAGADO, false, Gravity.LEFT);
        status.setVisibility(View.GONE);

        LinearLayout linhaCampo = new LinearLayout(m.act);
        linhaCampo.setOrientation(LinearLayout.HORIZONTAL);
        linhaCampo.setGravity(Gravity.CENTER_VERTICAL);
        linhaCampo.addView(campo, lp(m, 0, 38, 1f, 0, 0));
        linhaCampo.addView(ativar, lp(m, 86, 38, 0, 8, 0));

        LinearLayout formulario = pilha(m);
        formulario.setGravity(Gravity.LEFT);
        formulario.setPadding(m.d(16), 0, m.d(16), 0);
        formulario.addView(linhaCampo, lp(m, 0, 38, 0, 0, 0));
        formulario.addView(status, pilhaParams(m, 4));
        barra.addView(formulario, lp(m, 0, 0, 1f, 0, 0));

        View divisor = new View(m.act);
        divisor.setBackgroundColor(0x1FFFFFFF);
        LinearLayout.LayoutParams pd = new LinearLayout.LayoutParams(m.d(1),
                ViewGroup.LayoutParams.MATCH_PARENT);
        pd.leftMargin = m.d(6);
        pd.rightMargin = m.d(16);
        barra.addView(divisor, pd);

        final Button gratis = botao(m, vip ? "Entrar no SMARTEDTV" : "Continuar com anúncios",
                false, 12, true);
        gratis.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                if (Licenca.ativa(splash)) {
                    seguir(splash, campo);
                    return;
                }
                confirmarAnuncios(m, splash, new Runnable() {
                    @Override
                    public void run() {
                        seguir(splash, campo);
                    }
                });
            }
        });
        barra.addView(gratis, lp(m, -1, 38, 0, 0, 0));

        ativar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                final String codigo = campo.getText() == null ? "" : campo.getText().toString();
                if (codigo.trim().length() < 4) {
                    campo.requestFocus();
                    teclado(splash, campo);
                    avisar(status, AVISO_CODIGO, null);
                    return;
                }
                fecharTeclado(splash, campo);
                ativar.setEnabled(false);
                ativar.setText("Validando...");
                avisar(status, "Falando com o servidor de ativação...", null);
                new Thread(new Runnable() {
                    @Override
                    public void run() {
                        final String erro = Licenca.validar(splash, codigo);
                        splash.runOnUiThread(new Runnable() {
                            @Override
                            public void run() {
                                ativar.setEnabled(true);
                                ativar.setText("Ativar");
                                if (erro == null) {
                                    avisar(status, AVISO_VIP, Boolean.TRUE);
                                    gratis.setText("Entrar no SMARTEDTV");
                                } else {
                                    avisar(status, erro, Boolean.FALSE);
                                }
                            }
                        });
                    }
                }, "smarted-vip").start();
            }
        });

        campo.setOnFocusChangeListener(new View.OnFocusChangeListener() {
            @Override
            public void onFocusChange(View v, boolean temFoco) {
                campo.setBackground(m.campo(temFoco));
                if (temFoco) {
                    teclado(splash, campo);
                }
            }
        });
        campo.setOnEditorActionListener(new TextView.OnEditorActionListener() {
            @Override
            public boolean onEditorAction(TextView v, int acao, android.view.KeyEvent evento) {
                if (acao == EditorInfo.IME_ACTION_DONE) {
                    ativar.performClick();
                    return true;
                }
                return false;
            }
        });
        return barra;
    }

    private static void seguir(Activity splash, EditText campo) {
        fecharTeclado(splash, campo);
        aberta = false;
        SeedBase.iniciarKodi(splash);
    }

    private static void avisar(TextView status, String mensagem, Boolean sucesso) {
        status.setVisibility(View.VISIBLE);
        if (sucesso == null) {
            status.setTextColor(APAGADO);
        } else if (sucesso.booleanValue()) {
            status.setTextColor(0xFFFFFFFF);
        } else {
            status.setTextColor(0xFFE4E4E4);
        }
        status.setText(mensagem);
        Log.i(TAG, "BoasVindas: " + mensagem);
    }

    private static void confirmarAnuncios(Medidas m, Activity splash, final Runnable seguir) {
        final Dialog caixa = new Dialog(splash);
        caixa.requestWindowFeature(Window.FEATURE_NO_TITLE);

        LinearLayout corpo = pilha(m);
        corpo.setBackground(m.vidroForte());
        corpo.setPadding(m.d(20), m.d(18), m.d(20), m.d(16));
        corpo.addView(texto(m, "Continuar com anúncios?", 20, Color.WHITE, true, Gravity.LEFT));
        corpo.addView(texto(m, "Você vai ver anúncios durante o uso. Para removê-los,"
                + " assine pelo checkout ou ative um código VIP quando quiser.",
                11.5f, TEXTO, false, Gravity.LEFT), pilhaParams(m, 9));

        LinearLayout botoes = new LinearLayout(m.act);
        botoes.setOrientation(LinearLayout.HORIZONTAL);
        botoes.setBaselineAligned(false);
        Button voltar = botao(m, "Voltar", false, 12, true);
        Button seguirBotao = botao(m, "Continuar com anúncios", true, 12, true);
        botoes.addView(voltar, lp(m, 0, 38, 1f, 0, 0));
        botoes.addView(seguirBotao, lp(m, 0, 38, 1f, 9, 0));
        corpo.addView(botoes, pilhaParams(m, 12));

        caixa.setContentView(corpo);
        Window janela = caixa.getWindow();
        if (janela != null) {
            janela.setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));
            janela.addFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
            WindowManager.LayoutParams params = janela.getAttributes();
            params.dimAmount = 0.66f;
            params.width = m.d(430);
            janela.setAttributes(params);
        }
        voltar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                caixa.dismiss();
            }
        });
        seguirBotao.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                caixa.dismiss();
                seguir.run();
            }
        });
        caixa.show();
        seguirBotao.requestFocus();
    }

    // ------------------------------------------------------------ cabeçalho

    private interface Modo {
        void aoEscolher(boolean querTv);
    }

    private static View cabecalho(Medidas m, final Modo modo) {
        LinearLayout linha = new LinearLayout(m.act);
        linha.setOrientation(LinearLayout.HORIZONTAL);
        linha.setGravity(Gravity.CENTER_VERTICAL);

        LinearLayout esquerda = new LinearLayout(m.act);
        esquerda.setOrientation(LinearLayout.HORIZONTAL);
        esquerda.setGravity(Gravity.CENTER_VERTICAL);
        esquerda.addView(logo(m, 32), lp(m, 32, 32, 0, 0, 0));

        LinearLayout textos = pilha(m);
        textos.setGravity(Gravity.LEFT);
        LinearLayout.LayoutParams pt = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        pt.leftMargin = m.d(9);
        TextView nome = texto(m, "SMARTEDTV", 17, Color.WHITE, true, Gravity.LEFT);
        nome.setLetterSpacing(0.18f);
        textos.addView(nome);
        textos.addView(texto(m, "Ativação e assinatura", 10, APAGADO, false, Gravity.LEFT),
                pilhaParams(m, 2));
        esquerda.addView(textos, pt);
        linha.addView(esquerda, lp(m, 0, 0, 1f, 0, 0));

        if (modo == null) {
            return linha;
        }

        final boolean tv = Plataforma.eTV(m.act);
        final Button botaoTv = segmento(m, "Android TV", tv);
        final Button botaoCelular = segmento(m, "Celular", !tv);

        LinearLayout grupo = new LinearLayout(m.act);
        grupo.setOrientation(LinearLayout.HORIZONTAL);
        grupo.setGravity(Gravity.CENTER_VERTICAL);
        grupo.setBackground(m.pilula());
        grupo.setPadding(m.d(3), m.d(3), m.d(3), m.d(3));
        grupo.addView(botaoTv, lp(m, -1, 26, 0, 0, 0));
        grupo.addView(botaoCelular, lp(m, -1, 26, 0, 3, 0));
        linha.addView(grupo);

        botaoTv.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                if (!Plataforma.eTV(m.act)) {
                    modo.aoEscolher(true);
                }
            }
        });
        botaoCelular.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                if (Plataforma.eTV(m.act)) {
                    modo.aoEscolher(false);
                }
            }
        });
        return linha;
    }

    /** Logo do projeto (o mesmo ícone do app), com fallback desenhado. */
    private static ImageView logo(Medidas m, float tamanho) {
        ImageView logo = new ImageView(m.act);
        logo.setScaleType(ImageView.ScaleType.CENTER_CROP);
        try {
            Drawable icone = m.act.getPackageManager().getApplicationIcon(m.act.getPackageName());
            logo.setImageDrawable(icone);
        } catch (Throwable erro) {
            logo.setBackground(m.iconeMarca());
            Log.w(TAG, "BoasVindas: sem icone do app (" + erro + ")");
        }
        return logo;
    }

    // -------------------------------------------------------- ações e textos

    private static TextView texto(Medidas m, String conteudo, float tamanho, int cor,
                                  boolean negrito, int gravidade) {
        TextView texto = new TextView(m.act);
        texto.setText(conteudo);
        texto.setTextColor(cor);
        texto.setTextSize(TypedValue.COMPLEX_UNIT_SP, m.sp(tamanho));
        texto.setGravity(gravidade);
        texto.setIncludeFontPadding(false);
        if (negrito) {
            texto.setTypeface(Typeface.DEFAULT_BOLD);
        }
        return texto;
    }

    private static LinearLayout pilha(Medidas m) {
        LinearLayout pilha = new LinearLayout(m.act);
        pilha.setOrientation(LinearLayout.VERTICAL);
        pilha.setGravity(Gravity.CENTER_HORIZONTAL);
        pilha.setFocusable(false);
        return pilha;
    }

    private static LinearLayout cartao(Medidas m) {
        LinearLayout cartao = pilha(m);
        cartao.setGravity(Gravity.LEFT);
        cartao.setBackground(m.vidro());
        cartao.setPadding(m.d(12), m.d(12), m.d(12), m.d(12));
        return cartao;
    }

    /** Cartão grande da escolha de plataforma. */
    private static LinearLayout cartaoEscolha(Medidas m, String titulo, String detalhe) {
        final LinearLayout cartao = pilha(m);
        cartao.setGravity(Gravity.CENTER);
        cartao.setBackground(m.vidro());
        cartao.setPadding(m.d(12), m.d(12), m.d(12), m.d(12));
        cartao.setFocusable(true);
        cartao.setClickable(true);
        cartao.addView(texto(m, titulo, 18, Color.WHITE, true, Gravity.CENTER));
        cartao.addView(texto(m, detalhe, 11, TEXTO, false, Gravity.CENTER), pilhaParams(m, 5));

        cartao.setOnFocusChangeListener(new View.OnFocusChangeListener() {
            @Override
            public void onFocusChange(View v, boolean temFoco) {
                v.setBackground(m.vidroFoco(temFoco));
            }
        });
        return cartao;
    }

    private static EditText campoCodigo(Medidas m) {
        EditText campo = new EditText(m.act);
        campo.setHint("Código de ativação");
        campo.setTextColor(TINTA);
        campo.setHintTextColor(0xFF8A8A8A);
        campo.setTextSize(TypedValue.COMPLEX_UNIT_SP, m.sp(12.5f));
        campo.setSingleLine(true);
        campo.setGravity(Gravity.CENTER_VERTICAL);
        campo.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS);
        campo.setImeOptions(EditorInfo.IME_ACTION_DONE);
        campo.setBackground(m.campo(false));
        campo.setPadding(m.d(12), 0, m.d(12), 0);
        return campo;
    }

    private static Button botao(Medidas m, String rotulo, boolean primario, float tamanho,
                                boolean fantasma) {
        Button botao = new Button(m.act);
        botao.setText(rotulo);
        botao.setAllCaps(false);
        botao.setGravity(Gravity.CENTER);
        botao.setTextSize(TypedValue.COMPLEX_UNIT_SP, m.sp(tamanho));
        botao.setPadding(m.d(10), 0, m.d(10), 0);
        botao.setTextColor(primario ? 0xFF080808 : TINTA);
        if (primario) {
            botao.setTypeface(Typeface.DEFAULT_BOLD);
        }
        botao.setBackground(primario ? m.botaoPrimario(false) : m.botaoSecundario(fantasma, false));
        final boolean claro = primario;
        final boolean traco = fantasma;
        botao.setOnFocusChangeListener(new View.OnFocusChangeListener() {
            @Override
            public void onFocusChange(View v, boolean temFoco) {
                v.setBackground(claro ? m.botaoPrimario(temFoco)
                        : m.botaoSecundario(traco, temFoco));
            }
        });
        return botao;
    }

    private static Button segmento(Medidas m, String rotulo, boolean ativo) {
        Button segmento = new Button(m.act);
        segmento.setText(rotulo);
        segmento.setAllCaps(false);
        segmento.setGravity(Gravity.CENTER);
        segmento.setTextSize(TypedValue.COMPLEX_UNIT_SP, m.sp(11));
        segmento.setPadding(m.d(12), 0, m.d(12), 0);
        segmento.setTextColor(ativo ? 0xFF080808 : TEXTO);
        segmento.setBackground(m.segmento(ativo));
        return segmento;
    }

    // -------------------------------------------------------------- medidas

    private static LinearLayout.LayoutParams pilhaParams(Medidas m, float margemTopo) {
        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        params.topMargin = m.d(margemTopo);
        return params;
    }

    /** largura < 0 => WRAP_CONTENT, 0 => MATCH_PARENT (ou 0 com peso); altura <= 0 => WRAP. */
    private static LinearLayout.LayoutParams lp(Medidas m, float largura, float altura,
                                                float peso, float margemEsq, float margemTopo) {
        int larguraFinal;
        if (peso > 0f) {
            larguraFinal = 0;
        } else if (largura < 0f) {
            larguraFinal = ViewGroup.LayoutParams.WRAP_CONTENT;
        } else if (largura == 0f) {
            larguraFinal = ViewGroup.LayoutParams.MATCH_PARENT;
        } else {
            larguraFinal = m.d(largura);
        }
        int alturaFinal = altura <= 0f
                ? ViewGroup.LayoutParams.WRAP_CONTENT : m.d(altura);
        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
                larguraFinal, alturaFinal, peso);
        params.leftMargin = m.d(margemEsq);
        params.topMargin = m.d(margemTopo);
        return params;
    }

    private static FrameLayout.LayoutParams topo(Medidas m) {
        FrameLayout.LayoutParams params = new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, m.d(34));
        int margem = m.d(15);
        params.leftMargin = margem;
        params.rightMargin = margem;
        params.topMargin = m.d(13);
        return params;
    }

    private static FrameLayout.LayoutParams base(Medidas m, float largura, float altura) {
        FrameLayout.LayoutParams params = new FrameLayout.LayoutParams(
                m.d(largura), m.d(altura), Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL);
        params.bottomMargin = m.d(14);
        return params;
    }

    // ------------------------------------------------------------- fundo/QR

    private static void fundo(Medidas m, FrameLayout raiz) {
        raiz.setBackgroundColor(0xFF050505);
        raiz.addView(brilho(m, 0x17FFFFFF, 620f, -120, -200));
        raiz.addView(brilho(m, 0x0FFFFFFF, 420f, 760, -160));
        raiz.addView(brilho(m, 0x0BFFFFFF, 480f, 640, 320));
    }

    private static View brilho(Medidas m, int cor, float raio, float x, float y) {
        View bolha = new View(m.act);
        bolha.setBackground(m.brilho(cor, raio));
        FrameLayout.LayoutParams params = new FrameLayout.LayoutParams(m.d(raio), m.d(raio));
        params.leftMargin = m.d(x);
        params.topMargin = m.d(y);
        bolha.setLayoutParams(params);
        bolha.setFocusable(false);
        return bolha;
    }

    private static Bitmap lerImagem(Context contexto, String caminho) {
        try {
            return BitmapFactory.decodeStream(contexto.getAssets().open(caminho));
        } catch (Throwable erro) {
            return null;
        }
    }

    /** Abre o link no navegador do aparelho (checkout, site). */
    private static void abrirLink(Activity act, String url) {
        try {
            Intent ver = new Intent(Intent.ACTION_VIEW, Uri.parse(url));
            act.startActivity(ver);
            Log.i(TAG, "BoasVindas: abrindo " + url);
        } catch (Throwable erro) {
            Log.w(TAG, "BoasVindas: nenhum navegador (" + erro + ")");
        }
    }

    /** Compartilhamento nativo (celular/tablet). */
    public static void compartilhar(Activity splash) {
        try {
            Intent enviar = new Intent(Intent.ACTION_SEND);
            enviar.setType("text/plain");
            enviar.putExtra(Intent.EXTRA_TEXT, "Estou usando o SMARTEDTV e recomendo: " + SITE);
            enviar.putExtra(Intent.EXTRA_SUBJECT, "SMARTEDTV");
            splash.startActivity(Intent.createChooser(enviar, "Compartilhar aplicativo"));
        } catch (Throwable erro) {
            Log.w(TAG, "BoasVindas: compartilhar falhou (" + erro + ")");
        }
    }

    private static void teclado(Activity splash, EditText campo) {
        try {
            InputMethodManager ime = (InputMethodManager)
                    splash.getSystemService(Context.INPUT_METHOD_SERVICE);
            if (ime != null) {
                ime.showSoftInput(campo, InputMethodManager.SHOW_IMPLICIT);
            }
        } catch (Throwable ignorado) {
            // TV sem teclado na tela
        }
    }

    private static void fecharTeclado(Activity splash, EditText campo) {
        try {
            InputMethodManager ime = (InputMethodManager)
                    splash.getSystemService(Context.INPUT_METHOD_SERVICE);
            if (ime != null) {
                ime.hideSoftInputFromWindow(campo.getWindowToken(), 0);
            }
        } catch (Throwable ignorado) {
            // sem teclado na tela
        }
    }

    /** Escala e fábrica das formas monocromáticas. */
    private static final class Medidas {
        final Activity act;
        final float escala;

        Medidas(Activity act) {
            this.act = act;
            DisplayMetrics dm = act.getResources().getDisplayMetrics();
            float largura = dm.widthPixels / dm.density;
            float altura = dm.heightPixels / dm.density;
            float menor = Math.min(largura / BASE_L, altura / BASE_A);
            this.escala = menor <= 0f ? 1f : Math.max(0.55f, Math.min(1.35f, menor));
        }

        int d(float valor) {
            return Math.max(1, Math.round(valor * escala));
        }

        float sp(float valor) {
            return Math.max(9f, valor * escala);
        }

        GradientDrawable vidro() {
            GradientDrawable forma = new GradientDrawable(
                    GradientDrawable.Orientation.TOP_BOTTOM, new int[]{VIDRO_TOPO, VIDRO_BASE});
            forma.setCornerRadius(d(12));
            forma.setStroke(Math.max(1, d(1f)), BORDA);
            return forma;
        }

        GradientDrawable vidroFoco(boolean foco) {
            GradientDrawable forma = new GradientDrawable(
                    GradientDrawable.Orientation.TOP_BOTTOM,
                    new int[]{foco ? 0x26FFFFFF : VIDRO_TOPO, VIDRO_BASE});
            forma.setCornerRadius(d(12));
            forma.setStroke(Math.max(1, d(foco ? 2f : 1f)), foco ? 0xF2FFFFFF : BORDA);
            return forma;
        }

        GradientDrawable vidroForte() {
            GradientDrawable forma = new GradientDrawable(
                    GradientDrawable.Orientation.TOP_BOTTOM,
                    new int[]{0x1AFFFFFF, 0x0AFFFFFF});
            forma.setCornerRadius(d(12));
            forma.setStroke(Math.max(1, d(1f)), BORDA);
            return forma;
        }

        GradientDrawable chip() {
            GradientDrawable forma = new GradientDrawable();
            forma.setColor(0x0DFFFFFF);
            forma.setCornerRadius(d(999));
            forma.setStroke(Math.max(1, d(1f)), 0x24FFFFFF);
            return forma;
        }

        GradientDrawable pilula() {
            GradientDrawable forma = new GradientDrawable();
            forma.setColor(0x0BFFFFFF);
            forma.setCornerRadius(d(999));
            forma.setStroke(Math.max(1, d(1f)), BORDA);
            return forma;
        }

        GradientDrawable segmento(boolean ativo) {
            GradientDrawable forma = new GradientDrawable();
            if (ativo) {
                forma = new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
                        new int[]{0xFFFFFFFF, 0xFFE8E8E8});
            } else {
                forma.setColor(Color.TRANSPARENT);
            }
            forma.setCornerRadius(d(999));
            return forma;
        }

        GradientDrawable botaoPrimario(boolean foco) {
            GradientDrawable forma = new GradientDrawable(
                    GradientDrawable.Orientation.TOP_BOTTOM,
                    new int[]{0xFFFFFFFF, 0xFFEBEBEB});
            forma.setCornerRadius(d(8));
            if (foco) {
                forma.setStroke(Math.max(2, d(2f)), 0xFFFFFFFF);
            }
            return forma;
        }

        GradientDrawable botaoSecundario(boolean fantasma, boolean foco) {
            GradientDrawable forma = new GradientDrawable();
            forma.setColor(foco ? 0x1FFFFFFF : (fantasma ? 0x0BFFFFFF : 0x00000000));
            forma.setCornerRadius(d(8));
            forma.setStroke(Math.max(1, d(foco ? 2f : 1f)),
                    foco ? 0xF2FFFFFF : (fantasma ? 0x2EFFFFFF : 0x29FFFFFF));
            return forma;
        }

        GradientDrawable campo(boolean foco) {
            GradientDrawable forma = new GradientDrawable();
            forma.setColor(0x61000000);
            forma.setCornerRadius(d(8));
            forma.setStroke(Math.max(1, d(foco ? 2f : 1f)), foco ? 0x99FFFFFF : 0x26FFFFFF);
            return forma;
        }

        GradientDrawable traco() {
            GradientDrawable forma = new GradientDrawable();
            forma.setColor(0x8CFFFFFF);
            forma.setCornerRadius(d(999));
            return forma;
        }

        GradientDrawable bolinha() {
            GradientDrawable forma = new GradientDrawable();
            forma.setShape(GradientDrawable.OVAL);
            forma.setColor(0x14FFFFFF);
            forma.setStroke(Math.max(1, d(1f)), 0x29FFFFFF);
            return forma;
        }

        GradientDrawable iconeMarca() {
            GradientDrawable forma = new GradientDrawable(
                    GradientDrawable.Orientation.TOP_BOTTOM,
                    new int[]{0xFFFFFFFF, 0xFFBDBDBD});
            forma.setCornerRadius(d(8));
            return forma;
        }

        GradientDrawable brilho(int cor, float raio) {
            GradientDrawable forma = new GradientDrawable(
                    GradientDrawable.Orientation.TL_BR, new int[]{cor, 0x00000000});
            forma.setShape(GradientDrawable.OVAL);
            forma.setGradientType(GradientDrawable.RADIAL_GRADIENT);
            forma.setGradientRadius(d(raio));
            forma.setDither(true);
            return forma;
        }
    }
}
