package @APP_PACKAGE@;

import android.app.Activity;
import android.content.Context;
import android.content.Intent;
import android.content.res.Configuration;
import android.graphics.Bitmap;
import android.graphics.BitmapFactory;
import android.graphics.Color;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.text.InputType;
import android.util.Log;
import android.util.TypedValue;
import android.view.Gravity;
import android.view.View;
import android.view.ViewGroup;
import android.view.inputmethod.EditorInfo;
import android.view.inputmethod.InputMethodManager;
import android.widget.Button;
import android.widget.EditText;
import android.widget.FrameLayout;
import android.widget.ImageView;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;

/**
 * Tela de ativação/compartilhamento, exibida na splash TODAS as vezes que o
 * app abre e SEMPRE antes de qualquer anúncio.
 *
 * Primeira abertura: pergunta se o aparelho é CELULAR ou TV/BOX/PROJETOR (a
 * escolha fica gravada por Plataforma).
 *
 *  * CELULAR — botões grandes: "Quero assistir sem anúncios" (checkout Cakto),
 *    "Compartilhar aplicativo" (Intent nativo do Android), campo de código,
 *    "Continuar com anúncios";
 *  * TV/BOX/PROJETOR — no topo, dois QR codes legíveis com título:
 *    "Escaneie e Compartilhe" (indicação do app) e
 *    "Escaneie e compre o acesso mensal" (checkout), seguidos do campo de
 *    código e dos botões.
 *
 * Layout: duas colunas quando a tela está deitada (TV, box, projetor, celular
 * deitado) e uma coluna em pé. Tudo nativo e sem barra de rolagem visível: a
 * tela cabe inteira; o toque rola apenas se o aparelho for muito pequeno.
 */
public final class BoasVindas {

    private static final String TAG = "SmartAds";
    public static final String CHECKOUT = "https://pay.cakto.com.br/nkvbegd_1323120";
    public static final String SITE = "https://smartedtv-vip.lovable.app/";
    /** QR de compartilhamento (indicação do app) empacotado no APK. */
    private static final String QR_APP = "addons/script.smartedtv.ajustes/resources/qrcode.png";
    /** QR do checkout mensal (Cakto). */
    private static final String QR_CAKTO =
            "addons/script.smartedtv.ajustes/resources/qrcode-cakto.png";

    private static volatile boolean aberta;

    private BoasVindas() {
    }

    /** true = a tela foi montada (a splash NÃO deve abrir o Kodi ainda). */
    public static boolean mostrar(final Activity splash) {
        if (splash == null || aberta) {
            return false;
        }
        try {
            aberta = true;
            montar(splash);
            return true;
        } catch (Throwable erro) {
            aberta = false;
            Log.w(TAG, "BoasVindas: nao consegui montar (" + erro + ")");
            return false;
        }
    }

    private static boolean largo(Activity activity) {
        try {
            Configuration cfg = activity.getResources().getConfiguration();
            if (cfg.orientation == Configuration.ORIENTATION_LANDSCAPE) {
                return true;
            }
            return activity.getResources().getDisplayMetrics().widthPixels
                    > activity.getResources().getDisplayMetrics().heightPixels;
        } catch (Exception erro) {
            return true;
        }
    }

    // --------------------------------------------------------------- montagem

    private static void montar(final Activity splash) {
        if (Plataforma.escolhida(splash).length() == 0) {
            escolherPlataforma(splash);
            return;
        }
        desenhar(splash);
    }

    /** Primeira abertura: CELULAR ou TV, com a sugestão do sistema marcada. */
    private static void escolherPlataforma(final Activity splash) {
        boolean deitado = largo(splash);
        String sugestao = Plataforma.detectar(splash);

        FrameLayout fundo = new FrameLayout(splash);
        fundo.setBackgroundColor(Color.rgb(8, 8, 10));

        LinearLayout raiz = new LinearLayout(splash);
        raiz.setOrientation(LinearLayout.VERTICAL);
        raiz.setGravity(Gravity.CENTER);
        raiz.setPadding(dp(splash, 48), dp(splash, 32), dp(splash, 48), dp(splash, 32));

        TextView marca = new TextView(splash);
        marca.setText("SMARTEDTV");
        marca.setTextColor(Color.rgb(235, 235, 240));
        marca.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18);
        marca.setLetterSpacing(0.30f);
        marca.setGravity(Gravity.CENTER);
        raiz.addView(marca);

        TextView pergunta = new TextView(splash);
        pergunta.setText("Onde você está usando o app?");
        pergunta.setTextColor(Color.WHITE);
        pergunta.setTypeface(Typeface.DEFAULT_BOLD);
        pergunta.setTextSize(TypedValue.COMPLEX_UNIT_SP, 34);
        pergunta.setGravity(Gravity.CENTER);
        pergunta.setPadding(0, dp(splash, 18), 0, dp(splash, 8));
        raiz.addView(pergunta);

        TextView dica = new TextView(splash);
        dica.setText("A TV mostra os QR codes para compartilhar e comprar;"
                + " o celular compartilha pelo WhatsApp e abre o pagamento direto.");
        dica.setTextColor(Color.rgb(170, 170, 182));
        dica.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
        dica.setGravity(Gravity.CENTER);
        dica.setPadding(0, 0, 0, dp(splash, 26));
        raiz.addView(dica);

        LinearLayout opcoes = new LinearLayout(splash);
        opcoes.setOrientation(deitado ? LinearLayout.HORIZONTAL : LinearLayout.VERTICAL);
        opcoes.setGravity(Gravity.CENTER);

        final Button celular = botao(splash, "Celular", false);
        final Button tv = botao(splash, "TV / Box / Projetor", true);
        addOpcao(splash, opcoes, celular, Plataforma.CELULAR.equals(sugestao), deitado);
        addOpcao(splash, opcoes, tv, Plataforma.TV.equals(sugestao), deitado);
        raiz.addView(opcoes);

        celular.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Plataforma.salvar(splash, Plataforma.CELULAR);
                desenhar(splash);
            }
        });
        tv.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Plataforma.salvar(splash, Plataforma.TV);
                desenhar(splash);
            }
        });

        fundo.addView(raiz, new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
        splash.setContentView(fundo);
        if (Plataforma.TV.equals(sugestao)) {
            tv.requestFocus();
        } else {
            celular.requestFocus();
        }
        Log.i(TAG, "BoasVindas: escolha de plataforma (sugestao=" + sugestao + ")");
    }

    private static void addOpcao(Activity splash, LinearLayout opcoes, Button botao,
                                 boolean sugerido, boolean deitado) {
        LinearLayout caixa = new LinearLayout(splash);
        caixa.setOrientation(LinearLayout.VERTICAL);
        caixa.setGravity(Gravity.CENTER);
        caixa.addView(botao, params(splash, deitado ? 320 : 380, 78));
        if (sugerido) {
            TextView recomendado = new TextView(splash);
            recomendado.setText("recomendado para este aparelho");
            recomendado.setTextColor(Color.rgb(120, 200, 255));
            recomendado.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
            recomendado.setGravity(Gravity.CENTER);
            caixa.addView(recomendado);
        }
        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        p.rightMargin = dp(splash, deitado ? 20 : 0);
        p.bottomMargin = dp(splash, deitado ? 0 : 6);
        opcoes.addView(caixa, p);
    }

    /** Tela principal (escolha já feita): layout muda por plataforma. */
    private static void desenhar(final Activity splash) {
        final boolean vip = Licenca.ativa(splash);
        final boolean deitado = largo(splash);
        final boolean tv = Plataforma.eTV(splash);

        FrameLayout fundo = new FrameLayout(splash);
        fundo.setBackgroundColor(Color.rgb(8, 8, 10));
        fundo.setFocusable(false);

        ScrollView rolagem = new ScrollView(splash);
        rolagem.setFillViewport(true);
        rolagem.setVerticalScrollBarEnabled(false);     // sem barra de rolagem
        rolagem.setHorizontalScrollBarEnabled(false);
        rolagem.setOverScrollMode(View.OVER_SCROLL_NEVER);

        LinearLayout raiz = new LinearLayout(splash);
        raiz.setOrientation(deitado ? LinearLayout.HORIZONTAL : LinearLayout.VERTICAL);
        raiz.setGravity(Gravity.CENTER);
        int margem = dp(splash, deitado ? 48 : 24);
        raiz.setPadding(margem, dp(splash, 20), margem, dp(splash, 20));
        raiz.setFocusable(false);

        raiz.addView(tv ? colunaTv(splash, vip, deitado)
                        : colunaTexto(splash, vip, deitado),
                peso(raiz, deitado, tv));
        raiz.addView(colunaAcoes(splash, fundo, vip, deitado, tv),
                peso(raiz, deitado, tv));

        rolagem.addView(raiz, new ScrollView.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
        fundo.addView(rolagem, new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));

        splash.setContentView(fundo);
        Log.i(TAG, "BoasVindas: tela exibida (" + (deitado ? "deitada" : "em pe")
                + ", " + (tv ? "tv" : "celular") + ", vip=" + vip + ")");
    }

    private static LinearLayout.LayoutParams peso(LinearLayout raiz, boolean deitado,
                                                  boolean tv) {
        if (!deitado) {
            LinearLayout.LayoutParams vertical = new LinearLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
            vertical.bottomMargin = dp(raiz.getContext(), 12);
            return vertical;
        }
        LinearLayout.LayoutParams horizontal = new LinearLayout.LayoutParams(0,
                ViewGroup.LayoutParams.WRAP_CONTENT, tv ? 1.25f : 1f);
        horizontal.rightMargin = dp(raiz.getContext(), 24);
        return horizontal;
    }

    // ------------------------------------------------------------ lado esquerdo

    private static LinearLayout colunaTexto(Context contexto, boolean vip, boolean deitado) {
        LinearLayout coluna = new LinearLayout(contexto);
        coluna.setOrientation(LinearLayout.VERTICAL);
        coluna.setGravity(Gravity.CENTER_VERTICAL | Gravity.START);
        coluna.setFocusable(false);

        TextView marca = new TextView(contexto);
        marca.setText("SMARTEDTV");
        marca.setTextColor(Color.rgb(235, 235, 240));
        marca.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18);
        marca.setLetterSpacing(0.30f);
        coluna.addView(marca);

        TextView pergunta = new TextView(contexto);
        pergunta.setText("Deseja assistir\nsem anúncios?");
        pergunta.setTextColor(Color.WHITE);
        pergunta.setTypeface(Typeface.DEFAULT_BOLD);
        pergunta.setTextSize(TypedValue.COMPLEX_UNIT_SP, deitado ? 40 : 32);
        pergunta.setLineSpacing(0f, 0.95f);
        pergunta.setPadding(0, dp(contexto, 14), 0, dp(contexto, 14));
        coluna.addView(pergunta);

        TextView detalhe = new TextView(contexto);
        detalhe.setText(vip
                ? "Seu VIP está ativo. Bom filme!"
                : "Plano VIP por R$ 24,90/mês\n"
                        + "• zero anúncios\n"
                        + "• até 3 aparelhos\n"
                        + "• ativação na hora, por código");
        detalhe.setTextColor(Color.rgb(190, 190, 200));
        detalhe.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
        detalhe.setLineSpacing(0f, 1.2f);
        coluna.addView(detalhe);

        // QR pequeno também no celular: quem quiser instalar em outro aparelho
        // aponta a câmera (o compartilhamento por Intent está no botão).
        LinearLayout qr = new LinearLayout(contexto);
        qr.setOrientation(LinearLayout.HORIZONTAL);
        qr.setGravity(Gravity.CENTER_VERTICAL);
        qr.setFocusable(false);
        qr.setPadding(0, dp(contexto, 16), 0, 0);
        ImageView imagem = new ImageView(contexto);
        Bitmap mapa = imagemDoPacote(contexto, QR_APP);
        if (mapa != null) {
            imagem.setImageBitmap(mapa);
            imagem.setAdjustViewBounds(true);
            imagem.setScaleType(ImageView.ScaleType.FIT_CENTER);
            int lado = dp(contexto, 108);
            qr.addView(imagem, new LinearLayout.LayoutParams(lado, lado));
            TextView legendaQr = new TextView(contexto);
            legendaQr.setText("Aponte a câmera\npara baixar o app");
            legendaQr.setTextColor(Color.rgb(160, 160, 172));
            legendaQr.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
            legendaQr.setPadding(dp(contexto, 12), 0, 0, 0);
            qr.addView(legendaQr);
            coluna.addView(qr);
        }
        return coluna;
    }

    /** TV/BOX/PROJETOR: dois QR codes grandes com título no topo. */
    private static LinearLayout colunaTv(Context contexto, boolean vip, boolean deitado) {
        LinearLayout coluna = new LinearLayout(contexto);
        coluna.setOrientation(LinearLayout.VERTICAL);
        coluna.setGravity(Gravity.CENTER_VERTICAL);
        coluna.setFocusable(false);

        TextView marca = new TextView(contexto);
        marca.setText("SMARTEDTV  •  " + (vip ? "VIP ATIVO" : "GRÁTIS COM ANÚNCIOS"));
        marca.setTextColor(Color.rgb(235, 235, 240));
        marca.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
        marca.setLetterSpacing(0.18f);
        marca.setPadding(0, 0, 0, dp(contexto, 14));
        coluna.addView(marca);

        LinearLayout cartoes = new LinearLayout(contexto);
        cartoes.setOrientation(LinearLayout.HORIZONTAL);
        cartoes.setGravity(Gravity.CENTER_VERTICAL);
        cartoes.setFocusable(false);
        int lado = dp(contexto, deitado ? 190 : 160);
        cartoes.addView(cartaoQr(contexto, "Escaneie e Compartilhe", QR_APP,
                "indique o app para alguém", lado, 0));
        cartoes.addView(cartaoQr(contexto, "Escaneie e compre o acesso mensal", QR_CAKTO,
                "R$ 24,90/mês · Pix ou cartão", lado, dp(contexto, 18)));
        coluna.addView(cartoes);
        return coluna;
    }

    private static LinearLayout cartaoQr(Context contexto, String titulo, String asset,
                                         String legenda, int lado, int espacoEsquerda) {
        LinearLayout cartao = new LinearLayout(contexto);
        cartao.setOrientation(LinearLayout.VERTICAL);
        cartao.setGravity(Gravity.CENTER_HORIZONTAL);
        cartao.setFocusable(false);
        cartao.setBackground(placa(Color.rgb(18, 18, 22), Color.rgb(60, 60, 70)));
        cartao.setPadding(dp(contexto, 12), dp(contexto, 12), dp(contexto, 12), dp(contexto, 12));

        TextView tituloView = new TextView(contexto);
        tituloView.setText(titulo);
        tituloView.setTextColor(Color.WHITE);
        tituloView.setTypeface(Typeface.DEFAULT_BOLD);
        tituloView.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
        tituloView.setGravity(Gravity.CENTER);
        tituloView.setMaxLines(2);
        tituloView.setPadding(0, 0, 0, dp(contexto, 8));
        cartao.addView(tituloView, new LinearLayout.LayoutParams(
                lado, ViewGroup.LayoutParams.WRAP_CONTENT));

        ImageView imagem = new ImageView(contexto);
        Bitmap mapa = imagemDoPacote(contexto, asset);
        if (mapa != null) {
            imagem.setImageBitmap(mapa);
        }
        imagem.setAdjustViewBounds(true);
        imagem.setScaleType(ImageView.ScaleType.FIT_CENTER);
        imagem.setBackgroundColor(Color.WHITE);
        cartao.addView(imagem, new LinearLayout.LayoutParams(lado, lado));

        TextView legendaView = new TextView(contexto);
        legendaView.setText(legenda);
        legendaView.setTextColor(Color.rgb(160, 160, 172));
        legendaView.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
        legendaView.setGravity(Gravity.CENTER);
        legendaView.setPadding(0, dp(contexto, 6), 0, 0);
        cartao.addView(legendaView, new LinearLayout.LayoutParams(
                lado, ViewGroup.LayoutParams.WRAP_CONTENT));

        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        p.leftMargin = espacoEsquerda;
        cartao.setLayoutParams(p);
        return cartao;
    }

    // ------------------------------------------------------------ lado direito

    private static LinearLayout colunaAcoes(final Activity splash, final View fundo,
                                            final boolean vip, boolean deitado, boolean tv) {
        LinearLayout coluna = new LinearLayout(splash);
        coluna.setOrientation(LinearLayout.VERTICAL);
        coluna.setGravity(Gravity.CENTER_HORIZONTAL);
        coluna.setFocusable(false);

        int larguraBotao = dp(splash, deitado ? 440 : 380);
        int alturaBotao = dp(splash, deitado ? 66 : 62);

        final Button comprar = botao(splash, vip ? "Renovar meu plano VIP"
                : "Quero assistir sem anúncios", true);
        coluna.addView(comprar, paramsLargura(splash, larguraBotao, alturaBotao));

        TextView rotuloCodigo = new TextView(splash);
        rotuloCodigo.setText("Já tenho um código");
        rotuloCodigo.setTextColor(Color.rgb(160, 160, 172));
        rotuloCodigo.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
        rotuloCodigo.setGravity(Gravity.CENTER);
        rotuloCodigo.setPadding(0, dp(splash, 14), 0, dp(splash, 8));
        coluna.addView(rotuloCodigo);

        // o campo já nasce visível: um clique/toque e o teclado abre
        final EditText campo = new EditText(splash);
        campo.setHint("Digite o código aqui");
        campo.setTextColor(Color.WHITE);
        campo.setHintTextColor(Color.rgb(150, 150, 160));
        campo.setTextSize(TypedValue.COMPLEX_UNIT_SP, 19);
        campo.setSingleLine(true);
        campo.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS);
        campo.setImeOptions(EditorInfo.IME_ACTION_DONE);
        campo.setGravity(Gravity.CENTER);
        campo.setBackground(caixa(splash, false));
        campo.setPadding(dp(splash, 14), dp(splash, 12), dp(splash, 14), dp(splash, 12));
        coluna.addView(campo, paramsLargura(splash, larguraBotao, 58));

        final Button ativar = botao(splash, "Ativar agora", true);
        coluna.addView(ativar, paramsLargura(splash, larguraBotao, alturaBotao));

        final TextView status = new TextView(splash);
        status.setTextColor(Color.rgb(120, 220, 160));
        status.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
        status.setGravity(Gravity.CENTER);
        status.setPadding(0, dp(splash, 10), 0, 0);
        status.setVisibility(View.GONE);
        coluna.addView(status);

        // Celular: compartilha pelo Android. TV: o QR code já está no topo.
        final Button compartilhar = botao(splash, tv ? "Enviar o link para o celular"
                : "Compartilhar aplicativo", false);
        if (tv) {
            compartilhar.setVisibility(View.GONE);
        }
        coluna.addView(compartilhar, paramsLargura(splash, larguraBotao, alturaBotao));

        final Button continuar = botao(splash, vip ? "Entrar no SMARTEDTV"
                : "Continuar com anúncios", false);
        coluna.addView(continuar, paramsLargura(splash, larguraBotao, alturaBotao));

        final Button trocarModo = botao(splash, tv ? "Estou no celular" : "Estou na TV", false);
        coluna.addView(trocarModo, paramsLargura(splash, dp(splash, 240),
                dp(splash, 46)));

        abrirTecladoAoFocar(splash, campo);

        // --- ações -----------------------------------------------------------
        comprar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                abrir(splash, CHECKOUT);
            }
        });

        ativar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                final String texto = campo.getText() == null ? "" : campo.getText().toString();
                if (texto.trim().length() < 4) {
                    // um clique só: foca o campo e abre o teclado na mesma ação
                    campo.requestFocus();
                    teclado(splash, campo);
                    status.setVisibility(View.VISIBLE);
                    status.setTextColor(Color.rgb(210, 210, 220));
                    status.setText("Digite o código que você recebeu.");
                    return;
                }
                fecharTeclado(splash, campo);
                ativar.setEnabled(false);
                ativar.setText("Validando...");
                status.setVisibility(View.VISIBLE);
                status.setTextColor(Color.rgb(200, 200, 210));
                status.setText("Falando com o servidor de ativação...");
                new Thread(new Runnable() {
                    @Override
                    public void run() {
                        final String erro = Licenca.validar(splash, texto);
                        splash.runOnUiThread(new Runnable() {
                            @Override
                            public void run() {
                                ativar.setEnabled(true);
                                ativar.setText("Ativar agora");
                                if (erro == null) {
                                    status.setTextColor(Color.rgb(120, 220, 160));
                                    status.setText("VIP ativado! Nenhum anúncio nesta abertura.");
                                    comprar.setVisibility(View.GONE);
                                    continuar.setText("Entrar no SMARTEDTV");
                                    continuar.requestFocus();
                                } else {
                                    status.setTextColor(Color.rgb(235, 140, 140));
                                    status.setText(erro);
                                }
                            }
                        });
                    }
                }, "smarted-vip").start();
            }
        });

        compartilhar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                compartilhar(splash);
            }
        });

        continuar.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                fecharTeclado(splash, campo);
                aberta = false;
                fundo.setVisibility(View.GONE);
                SeedBase.iniciarKodi(splash);
            }
        });

        trocarModo.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                boolean eraTV = Plataforma.eTV(splash);
                Plataforma.salvar(splash, eraTV ? Plataforma.CELULAR : Plataforma.TV);
                desenhar(splash);
            }
        });

        comprar.requestFocus();
        return coluna;
    }

    // -------------------------------------------------------------- utilidades

    /** Intent nativo de compartilhamento (WhatsApp, Telegram, e-mail...). */
    private static void compartilhar(Activity splash) {
        try {
            Intent enviar = new Intent(Intent.ACTION_SEND);
            enviar.setType("text/plain");
            enviar.putExtra(Intent.EXTRA_TEXT,
                    "Estou usando o SMARTEDTV e recomendo: " + SITE);
            enviar.putExtra(Intent.EXTRA_SUBJECT, "SMARTEDTV");
            splash.startActivity(Intent.createChooser(enviar, "Compartilhar aplicativo"));
            Log.i(TAG, "BoasVindas: compartilhamento nativo aberto");
        } catch (Exception erro) {
            Log.w(TAG, "BoasVindas: compartilhar falhou (" + erro + ")");
        }
    }

    private static void abrir(Activity splash, String url) {
        try {
            splash.startActivity(new Intent(Intent.ACTION_VIEW, android.net.Uri.parse(url)));
            Log.i(TAG, "BoasVindas: abrindo " + url);
        } catch (Exception erro) {
            Log.w(TAG, "BoasVindas: sem navegador para " + url);
        }
    }

    private static Bitmap imagemDoPacote(Context contexto, String caminho) {
        try {
            java.io.InputStream fluxo = contexto.getAssets().open(caminho);
            try {
                return BitmapFactory.decodeStream(fluxo);
            } finally {
                fluxo.close();
            }
        } catch (Throwable erro) {
            Log.w(TAG, "BoasVindas: imagem fora do pacote (" + caminho + ": " + erro + ")");
            return null;
        }
    }

    private static void abrirTecladoAoFocar(final Activity splash, final EditText campo) {
        campo.setOnFocusChangeListener(new View.OnFocusChangeListener() {
            @Override
            public void onFocusChange(View v, boolean temFoco) {
                if (temFoco) {
                    teclado(splash, campo);
                }
            }
        });
    }

    private static void teclado(Activity splash, EditText campo) {
        try {
            InputMethodManager ime = (InputMethodManager)
                    splash.getSystemService(Context.INPUT_METHOD_SERVICE);
            if (ime != null) {
                ime.showSoftInput(campo, InputMethodManager.SHOW_IMPLICIT);
            }
        } catch (Exception erro) {
            Log.w(TAG, "BoasVindas: teclado nao abriu (" + erro + ")");
        }
    }

    private static void fecharTeclado(Activity splash, EditText campo) {
        try {
            InputMethodManager ime = (InputMethodManager)
                    splash.getSystemService(Context.INPUT_METHOD_SERVICE);
            if (ime != null) {
                ime.hideSoftInputFromWindow(campo.getWindowToken(), 0);
            }
        } catch (Exception ignorado) {
            // sem teclado aberto
        }
    }

    private static int dp(Context contexto, int valor) {
        return (int) (valor * contexto.getResources().getDisplayMetrics().density);
    }

    private static LinearLayout.LayoutParams paramsLargura(Context contexto, int largura,
                                                           int altura) {
        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(
                Math.min(largura, contexto.getResources().getDisplayMetrics().widthPixels
                        - dp(contexto, 48)), dp(contexto, altura));
        p.topMargin = dp(contexto, 10);
        return p;
    }

    private static GradientDrawable caixa(Context contexto, boolean foco) {
        GradientDrawable forma = new GradientDrawable();
        forma.setCornerRadius(24f);
        forma.setColor(Color.rgb(26, 26, 32));
        forma.setStroke(2, foco ? Color.WHITE : Color.rgb(80, 80, 92));
        return forma;
    }

    private static GradientDrawable placa(int cor, int borda) {
        GradientDrawable forma = new GradientDrawable();
        forma.setCornerRadius(18f);
        forma.setColor(cor);
        forma.setStroke(2, borda);
        return forma;
    }

    private static Button botao(Context contexto, String texto, boolean destaque) {
        Button botao = new Button(contexto);
        aplicarFundo(botao, destaque, false);
        botao.setText(texto);
        botao.setTextSize(TypedValue.COMPLEX_UNIT_SP, 19);
        botao.setTextColor(destaque ? Color.rgb(10, 10, 10) : Color.WHITE);
        botao.setAllCaps(false);
        botao.setFocusable(true);
        botao.setFocusableInTouchMode(true);
        final boolean claro = destaque;
        botao.setOnFocusChangeListener(new View.OnFocusChangeListener() {
            @Override
            public void onFocusChange(View v, boolean temFoco) {
                aplicarFundo((Button) v, claro, temFoco);
                v.setScaleX(temFoco ? 1.04f : 1.0f);
                v.setScaleY(temFoco ? 1.04f : 1.0f);
            }
        });
        return botao;
    }

    private static void aplicarFundo(Button botao, boolean destaque, boolean foco) {
        GradientDrawable forma = new GradientDrawable();
        forma.setCornerRadius(32f);
        if (destaque) {
            forma.setColor(foco ? Color.rgb(255, 255, 255) : Color.rgb(238, 238, 244));
        } else {
            forma.setColor(foco ? Color.rgb(74, 74, 86) : Color.rgb(30, 30, 36));
            forma.setStroke(2, foco ? Color.WHITE : Color.rgb(74, 74, 86));
        }
        botao.setBackground(forma);
    }
}
