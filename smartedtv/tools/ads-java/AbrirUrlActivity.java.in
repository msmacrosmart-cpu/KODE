package @APP_PACKAGE@;

import android.app.Activity;
import android.content.ActivityNotFoundException;
import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.util.Log;

/**
 * Abre um link no navegador do aparelho (checkout da Cakto, site, etc.).
 *
 * Chamada pelo add-on do Kodi pela ponte:
 *   StartAndroidActivity(smartedtv.full, smartedtv.ABRIR, , smartedtv://abrir?url=..., ...)
 *
 * Existe porque o builtin do Kodi nao consegue abrir URL externa de forma
 * confiavel em Android TV; aqui o intent e explicito e sempre funciona.
 */
public class AbrirUrlActivity extends Activity {

    private static final String TAG = "SmartAds";

    @Override
    protected void onCreate(Bundle estado) {
        super.onCreate(estado);
        String url = url(getIntent());
        if (url == null || url.isEmpty()) {
            Log.w(TAG, "AbrirUrl: nenhum link recebido");
            finish();
            return;
        }
        try {
            Intent abrir = new Intent(Intent.ACTION_VIEW, Uri.parse(url));
            abrir.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
            startActivity(abrir);
            Log.i(TAG, "AbrirUrl: abrindo " + url);
        } catch (ActivityNotFoundException erro) {
            Log.w(TAG, "AbrirUrl: nenhum navegador para " + url);
        }
        finish();
    }

    /** Prioridade: extra "url"; senão o parâmetro url= do data. */
    static String url(Intent intent) {
        if (intent == null) {
            return "";
        }
        String extra = intent.getStringExtra("url");
        if (extra != null && extra.length() > 0) {
            return extra.trim();
        }
        String data = intent.getDataString();
        if (data == null) {
            return "";
        }
        int marca = data.indexOf("url=");
        if (marca < 0) {
            return "";
        }
        String resto = data.substring(marca + 4);
        try {
            return Uri.decode(resto);
        } catch (Exception erro) {
            return resto;
        }
    }
}
