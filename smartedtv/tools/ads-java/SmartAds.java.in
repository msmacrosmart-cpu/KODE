package @APP_PACKAGE@;

import android.content.Context;
import android.content.Intent;
import android.util.Log;

import com.google.android.gms.ads.MobileAds;
import com.google.android.gms.ads.RequestConfiguration;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

/**
 * Constantes, modo de teste e inicializacao unica do AdMob DENTRO do app.
 *
 * Este arquivo e copiado para tools/android/packaging/xbmc/src/ pelo
 * smartedtv/tools/integrate-monolith.py e entra no APK unico (applicationId
 * smartedtv.full). Nao existe mais app auxiliar: o anuncio roda no mesmo
 * processo do player.
 *
 * Tag de log unica: "SmartAds" (adb logcat -s SmartAds).
 */
public final class SmartAds {

    public static final String TAG = "SmartAds";

    /** APPLICATION_ID do AdMob (o mesmo do AndroidManifest.xml). */
    public static final String APP_ID = "ca-app-pub-2066014755407744~5076693043";

    /** Blocos REAIS do projeto. */
    public static final String UNIT_APP_OPEN = "ca-app-pub-2066014755407744/4214378379";
    public static final String UNIT_PREROLL = "ca-app-pub-2066014755407744/3572039686";

    /** Blocos de TESTE oficiais do Google (sempre preenchem). */
    public static final String UNIT_APP_OPEN_TESTE = "ca-app-pub-3940256099942544/9257395921";
    public static final String UNIT_PREROLL_TESTE = "ca-app-pub-3940256099942544/1033173712";

    /**
     * PRODUÇÃO: usa os blocos REAIS do projeto. Em produção isto é sempre
     * false — os blocos de teste do Google só existem para depurar no
     * aparelho, e são ligados de propósito pelo intent
     * ``smartedtv://ads?teste=1`` (nunca pelo build).
     */
    private static boolean teste = false;

    private static boolean inicializado;

    /** true = anuncios ligados. Controlado pelo intent (ads=0 desliga). */
    private static boolean ligado = true;

    private SmartAds() {
    }

    public static boolean testeAtivo() {
        return teste;
    }

    /**
     * Porta unica: algum anuncio pode aparecer agora?
     *
     * Falso quando a licenca VIP esta ativa (o add-on do Kodi grava vip.json
     * depois de validar o codigo do site) ou quando o proprio intent pediu
     * ``ads=0``. Todas as telas de anuncio passam por aqui.
     */
    public static boolean adsPermitidos(Context contexto) {
        if (!ligado) {
            return false;
        }
        try {
            if (Licenca.ativa(contexto)) {
                return false;
            }
        } catch (Throwable erro) {
            Log.w(TAG, "SmartAds: licenca ilegivel, seguindo com anuncios (" + erro + ")");
        }
        return true;
    }

    public static String unidadeAppOpen() {
        return teste ? UNIT_APP_OPEN_TESTE : UNIT_APP_OPEN;
    }

    public static String unidadePreRoll() {
        return teste ? UNIT_PREROLL_TESTE : UNIT_PREROLL;
    }

    /**
     * Troca o modo de teste sem recompilar: o data do intent
     * smartedtv://ads?teste=0 (ou =1) vindo do Kodi.
     */
    public static void aplicarIntent(Intent intent) {
        if (intent == null) {
            return;
        }
        String data = intent.getDataString();
        if (data != null && data.contains("ads=")) {
            ligado = !data.endsWith("ads=0");
            Log.i(TAG, "anuncios " + (ligado ? "ligados" : "desligados") + " pelo intent (" + data + ")");
        }
        if (data == null || !data.contains("teste=")) {
            return;
        }
        boolean antes = teste;
        teste = !data.endsWith("teste=0");
        Log.i(TAG, "modo de teste alterado pelo intent (" + data + "): " + antes + " -> " + teste);
    }

    public static synchronized void init(Context context) {
        if (inicializado) {
            return;
        }
        inicializado = true;
        try {
            List<String> dispositivos = new ArrayList<>();
            MobileAds.setRequestConfiguration(
                    new RequestConfiguration.Builder()
                            .setTestDeviceIds(dispositivos.isEmpty()
                                    ? Arrays.<String>asList() : dispositivos)
                            .build());
            Log.i(TAG, "config: teste=" + teste
                    + " unidades=" + (teste ? "TESTE do Google" : "REAIS do projeto")
                    + " appId=" + APP_ID);
            MobileAds.initialize(context, status ->
                    Log.i(TAG, "AdMob inicializado: " + status.getAdapterStatusMap().keySet()));
        } catch (Throwable erro) {
            Log.e(TAG, "AdMob nao inicializou: " + erro, erro);
        }
    }
}
