package @APP_PACKAGE@;

import android.app.Activity;
import android.content.Intent;
import android.os.Bundle;
import android.util.Log;

/**
 * "Compartilhar Aplicativo": abre a folha de compartilhamento do Android
 * (WhatsApp, Telegram, e-mail...) com o link de download do APK.
 *
 * O QR do celular (resources/qrcode.png) leva ao mesmo endereço.
 *
 * Chamada pelo add-on do Kodi:
 *   StartAndroidActivity(smartedtv.full, smartedtv.COMPARTILHAR, , smartedtv://compartilhar?texto=...)
 */
public class CompartilharActivity extends Activity {

    private static final String TAG = "SmartAds";
    /** Mesmo endereço do QR de compartilhamento (resources/qrcode.png). */
    private static final String LINK =
            "https://www.dropbox.com/scl/fi/adn9elzkjzxof741bbui2/SMARTEDTV-atual.apk"
                    + "?rlkey=yp1ijxk6fdtcqm93gzi24ig5j&dl=1";
    private static final String CONVITE =
            "Instale o SMARTEDTV (TV, filmes e séries): " + LINK;

    @Override
    protected void onCreate(Bundle estado) {
        super.onCreate(estado);
        String texto = texto(getIntent());
        try {
            Intent enviar = new Intent(Intent.ACTION_SEND);
            enviar.setType("text/plain");
            enviar.putExtra(Intent.EXTRA_SUBJECT, "SMARTEDTV");
            enviar.putExtra(Intent.EXTRA_TEXT, texto);
            Intent escolha = Intent.createChooser(enviar, "Compartilhar aplicativo");
            escolha.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
            startActivity(escolha);
            Log.i(TAG, "Compartilhar: folha aberta");
        } catch (Exception erro) {
            Log.w(TAG, "Compartilhar: falhou (" + erro.getClass().getSimpleName() + ")");
        }
        finish();
    }

    static String texto(Intent intent) {
        if (intent == null) {
            return CONVITE;
        }
        String extra = intent.getStringExtra("texto");
        if (extra == null || extra.length() == 0) {
            String data = intent.getDataString();
            if (data != null) {
                int marca = data.indexOf("texto=");
                if (marca >= 0) {
                    try {
                        extra = android.net.Uri.decode(data.substring(marca + 6));
                    } catch (Exception erro) {
                        extra = data.substring(marca + 6);
                    }
                }
            }
        }
        return extra == null || extra.length() == 0 ? CONVITE : extra;
    }
}
