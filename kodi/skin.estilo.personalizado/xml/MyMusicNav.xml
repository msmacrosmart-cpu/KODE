<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<menucontrol>9000</menucontrol>
	<views>50,52,53,54,55,500</views>
	<controls>
		<include>DefaultBackground</include>
		<control type="image"><left>0</left><top>0</top><width>100%</width><height>100%</height><texture colordiffuse="pb_dark">pb_white.png</texture></control>
		<control type="image"><left>0</left><top>0</top><width>100%</width><height>100%</height><aspectratio>scale</aspectratio><texture background="true" colordiffuse="A0FFFFFF">$INFO[Container(50).ListItem.Art(fanart)]</texture><visible>!Skin.HasSetting(no_fanart)</visible></control>
		<control type="image"><left>0</left><top>0</top><width>100%</width><height>100%</height><texture>pb_scrim_h.png</texture></control>
		<control type="label"><left>60</left><top>40</top><width>400</width><height>40</height><font>font12</font><textcolor>pb_white</textcolor><label>NOVA TV</label></control>
		<control type="group">
			<include>View_50_List</include>
			<include>View_52_IconWall</include>
			<include>View_53_Shift</include>
			<include>View_54_InfoWall</include>
			<include>View_55_WideList</include>
			<include>View_500_Wall</include>
			<include>CommonScrollbars</include>
			<control type="group">
				<depth>DepthBars</depth>
				<bottom>0</bottom>
				<height>70</height>
				<include condition="!Skin.HasSetting(hide_mediaflags) + ![Window.IsVisible(songinformation) | Window.IsVisible(musicinformation)]">MediaFlags</include>
			</control>
			<include>MediaMenuMouseOverlay</include>
			<control type="grouplist" id="9000">
				<left>60</left>
				<top>100</top>
				<width>320</width>
				<height>880</height>
				<orientation>vertical</orientation>
				<itemgap>4</itemgap>
				<scrolltime>200</scrolltime>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<onright>50</onright>
				<control type="label" id="203">
					<description>Actions</description>
					<include>MediaMenuLabelCommon</include>
					<label>AÇÕES</label>
				</control>
				<control type="togglebutton" id="619">
					<width>320</width>
					<height>62</height>
					<font>font12</font>
					<textoffsetx>28</textoffsetx>
					<textcolor>pb_muted</textcolor>
					<focusedcolor>pb_dark</focusedcolor>
					<aligny>center</aligny>
					<label>Atualizar biblioteca</label>
					<altlabel>Atualizando biblioteca</altlabel>
					<usealttexture>library.isscanningmusic</usealttexture>
					<texturefocus colordiffuse="pb_white" border="16">pb_rounded.png</texturefocus>
					<texturenofocus colordiffuse="pb_panel2" border="16">pb_rounded.png</texturenofocus>
					<onclick>UpdateLibrary(music)</onclick>
					<visible>!Container.Content(addons)+ String.IsEmpty(Container.PluginName)</visible>
				</control>
				<control type="radiobutton" id="16">
					<width>320</width>
					<height>62</height>
					<font>font12</font>
					<textoffsetx>28</textoffsetx>
					<textcolor>pb_muted</textcolor>
					<focusedcolor>pb_dark</focusedcolor>
					<aligny>center</aligny>
					<label>Seguir reproduzindo</label>
					<texturefocus colordiffuse="pb_white" border="16">pb_rounded.png</texturefocus>
					<texturenofocus colordiffuse="pb_panel2" border="16">pb_rounded.png</texturenofocus>
				</control>
				<control type="button" id="612">
					<width>320</width>
					<height>62</height>
					<font>font12</font>
					<textoffsetx>28</textoffsetx>
					<textcolor>pb_muted</textcolor>
					<focusedcolor>pb_dark</focusedcolor>
					<aligny>center</aligny>
					<label>Lista de reprodução</label>
					<texturefocus colordiffuse="pb_white" border="16">pb_rounded.png</texturefocus>
					<texturenofocus colordiffuse="pb_panel2" border="16">pb_rounded.png</texturenofocus>
					<onclick>ActivateWindow(musicplaylist)</onclick>
					<visible>Integer.IsGreater(Playlist.Length(music),0)</visible>
				</control>
				<control type="button" id="621">
					<width>320</width>
					<height>62</height>
					<font>font12</font>
					<textoffsetx>28</textoffsetx>
					<textcolor>pb_muted</textcolor>
					<focusedcolor>pb_dark</focusedcolor>
					<aligny>center</aligny>
					<label>Complementos</label>
					<texturefocus colordiffuse="pb_white" border="16">pb_rounded.png</texturefocus>
					<texturenofocus colordiffuse="pb_panel2" border="16">pb_rounded.png</texturenofocus>
					<onclick>ActivateWindow(addonbrowser,addons://more/audio/,return)</onclick>
					<visible>Container.Content(addons)</visible>
				</control><control type="button" id="9053"><width>320</width><height>62</height><font>font12</font><textoffsetx>28</textoffsetx><textcolor>pb_muted</textcolor><focusedcolor>pb_dark</focusedcolor><aligny>center</aligny><label>MP3 Streams</label><texturefocus colordiffuse="pb_white" border="16">pb_rounded.png</texturefocus><texturenofocus colordiffuse="pb_panel2" border="16">pb_rounded.png</texturenofocus><onclick>ActivateWindow(10025, "plugin://plugin.audio.mp3streams/")</onclick><visible>System.HasAddon(plugin.audio.mp3streams)</visible></control>
				<control type="button" id="624">
					<width>320</width>
					<height>62</height>
					<font>font12</font>
					<textoffsetx>28</textoffsetx>
					<textcolor>pb_muted</textcolor>
					<focusedcolor>pb_dark</focusedcolor>
					<aligny>center</aligny>
					<label>Configurações</label>
					<texturefocus colordiffuse="pb_white" border="16">pb_rounded.png</texturefocus>
					<texturenofocus colordiffuse="pb_panel2" border="16">pb_rounded.png</texturenofocus>
					<onclick>Addon.OpenSettings($INFO[Container.PluginName])</onclick>
					<visible>!String.IsEmpty(Container.PluginName)</visible>
				</control>
				<control type="button" id="622">
					<width>320</width>
					<height>62</height>
					<font>font12</font>
					<textoffsetx>28</textoffsetx>
					<textcolor>pb_muted</textcolor>
					<focusedcolor>pb_dark</focusedcolor>
					<aligny>center</aligny>
					<label>Editor de categoria</label>
					<texturefocus colordiffuse="pb_white" border="16">pb_rounded.png</texturefocus>
					<texturenofocus colordiffuse="pb_panel2" border="16">pb_rounded.png</texturenofocus>
					<onclick condition="System.AddonIsEnabled(plugin.library.node.editor)">ActivateWindow(programs,plugin://plugin.library.node.editor/?ltype=music,return)</onclick>
					<onclick condition="System.HasAddon(plugin.library.node.editor) + !System.AddonIsEnabled(plugin.library.node.editor)">EnableAddon(plugin.library.node.editor)</onclick>
					<onclick condition="!System.HasAddon(plugin.library.node.editor)">InstallAddon(plugin.library.node.editor)</onclick>
					<visible>String.IsEmpty(Container.FolderPath) + String.IsEmpty(Container.PluginName)</visible>
				</control>
				<control type="button" id="9050">
					<width>320</width>
					<height>62</height>
					<font>font12</font>
					<textoffsetx>28</textoffsetx>
					<textcolor>pb_muted</textcolor>
					<focusedcolor>pb_dark</focusedcolor>
					<aligny>center</aligny>
					<label>Busca</label>
					<texturefocus colordiffuse="pb_white" border="16">pb_rounded.png</texturefocus>
					<texturenofocus colordiffuse="pb_panel2" border="16">pb_rounded.png</texturenofocus>
					<onclick>ActivateWindow(1107)</onclick>
				</control>
				<control type="button" id="9051">
					<width>320</width>
					<height>62</height>
					<font>font12</font>
					<textoffsetx>28</textoffsetx>
					<textcolor>pb_muted</textcolor>
					<focusedcolor>pb_dark</focusedcolor>
					<aligny>center</aligny>
					<label>Ajustes</label>
					<texturefocus colordiffuse="pb_white" border="16">pb_rounded.png</texturefocus>
					<texturenofocus colordiffuse="pb_panel2" border="16">pb_rounded.png</texturenofocus>
					<onclick>ActivateWindow(Settings)</onclick>
				</control>
				<control type="button" id="9052">
					<width>320</width>
					<height>62</height>
					<font>font12</font>
					<textoffsetx>28</textoffsetx>
					<textcolor>pb_muted</textcolor>
					<focusedcolor>pb_dark</focusedcolor>
					<aligny>center</aligny>
					<label>Sair</label>
					<texturefocus colordiffuse="pb_white" border="16">pb_rounded.png</texturefocus>
					<texturenofocus colordiffuse="pb_panel2" border="16">pb_rounded.png</texturenofocus>
					<onclick>ActivateWindow(Home)</onclick>
				</control>
			</control>
			<include content="TopBar">
				<param name="breadcrumbs_label" value="MÚSICA" />
			</include>
			<include content="BottomBar">
				<param name="info_visible" value="true" />
			</include>
		</control>
	</controls>
</window>
