<?xml version="1.0" encoding="UTF-8"?>
<!--
  Secret Unlock — Brazuka Play Skin
  8 cliques no logo (top-left) + 2 ciclos completos de entrar/sair no Settings
  Libera configurações avançadas quando ambas condições são satisfeitas
-->
<includes>
	<!-- Botão clickável transparente sobre o logo -->
	<include name="SecretLogoButton">
		<control type="button">
			<left>60</left>
			<top>40</top>
			<width>320</width>
			<height>56</height>
			<texturefocus/>
			<texturenofocus/>
			<onclick condition="Integer.IsGreaterOrEqual(Skin.GetSetting(secret_click_count),7)">Skin.SetSetting(secret_click_count,0)</onclick>
			<onclick>Skin.SetSetting(secret_click_count,Skin.GetSetting(secret_click_count)+1)</onclick>
			<onup>9051</onup>
			<ondown>9000</ondown>
		</control>
	</include>

	<!-- Contador de cliques (invisível) -->
	<include name="SecretClickCounter">
		<control type="label">
			<visible>false</visible>
			<label>$INFO[Skin.GetSetting(secret_click_count)]</label>
		</control>
	</include>

	<!-- Status do unlock -->
	<include name="SecretUnlockStatus">
		<control type="label">
			<visible condition="Integer.IsGreaterOrEqual(Skin.GetSetting(secret_click_count),8) + Integer.IsGreaterOrEqual(Skin.GetSetting(secret_settings_cycle),2)">true</visible>
			<label>UNLOCKED</label>
			<font>font12</font>
			<textcolor>pb_white</textcolor>
		</control>
	</include>

	<!-- Configuração avançada liberada -->
	<include name="SecretAdvancedSettings">
		<control type="button">
			<label>Configurações Avançadas</label>
			<onclick>ActivateWindow(SkinSettings)</onclick>
			<visible condition="Integer.IsGreaterOrEqual(Skin.GetSetting(secret_click_count),8) + Integer.IsGreaterOrEqual(Skin.GetSetting(secret_settings_cycle),2)">true</visible>
			<texturefocus colordiffuse="pb_white" border="16">pb_rounded.png</texturefocus>
			<texturenofocus colordiffuse="pb_panel2" border="16">pb_rounded.png</texturenofocus>
		</control>
	</include>

	<!-- Ciclo Settings tracking -->
	<include name="SecretSettingsCycle">
		<control type="button">
			<visible>false</visible>
			<onclick>Skin.SetSetting(secret_settings_cycle,Skin.GetSetting(secret_settings_cycle)+1)</onclick>
		</control>
	</include>
</includes>
