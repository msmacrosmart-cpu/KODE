<?xml version="1.0" encoding="UTF-8"?>
<!--
  Modo avançado — SMARTEDTV

  Regra única e definitiva: entrar em Ajustes 5 vezes seguidas. Nada de cliques
  na logo, nada de etapas extras.

  * Settings.xml tem <onload>RunScript(service.smarted.bootstrap,secret-cycle)</onload>
    — o addon soma a visita e, na 5ª, executa Skin.SetBool(secret_unlocked).
  * Skin.HasSetting(secret_unlocked) é um skin bool: fica gravado em
    addon_data/skin.novatv/settings.xml, ou seja continua liberado depois de
    reiniciar o app.
  * As opções administrativas de Ajustes usam exatamente essa condição.
  * O contador (Skin.String(secret_settings_cycle)) é o único valor textual,
    gravado pelo builtin oficial Skin.SetString.
-->
<includes>

	<!-- Estado do modo avançado (1 = liberado) -->
	<include name="SecretUnlockStatus">
		<control type="label">
			<right>270</right>
			<top>40</top>
			<width>240</width>
			<height>52</height>
			<font>font10</font>
			<textcolor>pb_muted</textcolor>
			<align>right</align>
			<aligny>center</aligny>
			<label>Modo avançado ativo</label>
			<visible>Skin.HasSetting(secret_unlocked)</visible>
		</control>
	</include>

	<!-- Progresso discreto (some quando liberado) -->
	<include name="SecretClickCounter">
		<control type="label">
			<right>270</right>
			<top>40</top>
			<width>240</width>
			<height>52</height>
			<font>font10</font>
			<textcolor>pb_muted</textcolor>
			<align>right</align>
			<aligny>center</aligny>
			<label>$VAR[SecretClickLabelVar]</label>
			<visible>!Skin.HasSetting(secret_unlocked) + Integer.IsGreater(Skin.String(secret_settings_cycle),0)</visible>
		</control>
	</include>

	<!-- Atalho administrativo liberado pelo modo avançado -->
	<include name="SecretAdvancedSettings">
		<control type="button">
			<label>Configurações Avançadas</label>
			<onclick>ActivateWindow(SkinSettings)</onclick>
			<visible>Skin.HasSetting(secret_unlocked)</visible>
			<texturefocus colordiffuse="pb_white" border="16">pb_rounded.png</texturefocus>
			<texturenofocus colordiffuse="pb_panel2" border="16">pb_rounded.png</texturenofocus>
		</control>
	</include>

	<!-- Uma visita por abertura de Ajustes -->
	<include name="SecretSettingsCycle">
		<control type="button">
			<visible>false</visible>
			<onclick>RunScript(service.smarted.bootstrap,secret-cycle)</onclick>
		</control>
	</include>
</includes>
