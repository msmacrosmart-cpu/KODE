        <setting id="AutoScroll" type="boolean" label="Auto-rolagem automática">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="autoscroll" type="boolean" label="Auto-rolagem">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="background_overlay" type="string" label="Overlay do fundo">
          <level>0</level>
