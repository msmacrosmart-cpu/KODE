<?xml version="1.0" encoding="UTF-8"?>
<!--
  Definições de settings da skin.
  Esta skin é empacotada como o addon skin.novatv (id que o launcher do dex
  aplica no primeiro boot), portanto a section id deve permanecer skin.novatv.
  Formato padrão de resources/settings.xml de addons de Kodi 21.
-->
<settings version="1">
  <section id="skin.novatv">
    <category id="home" label="Início">
      <group id="1">
        <setting id="home_layout" type="string" label="Layout da tela inicial">
          <level>0</level>
          <default></default>
          <control type="edit" format="string"/>
        </setting>
        <setting id="pb_hide_hero" type="boolean" label="Ocultar hero da tela inicial">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="pb_hide_clock" type="boolean" label="Ocultar relógio da tela inicial">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="no_fanart" type="boolean" label="Sem fanart na tela inicial">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="touchmode" type="boolean" label="Modo touchscreen">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="show_profileavatar" type="boolean" label="Mostrar avatar do perfil">
