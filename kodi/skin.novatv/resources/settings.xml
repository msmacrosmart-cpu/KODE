        <setting id="hide_mediaflags" type="boolean" label="Ocultar flags de mídia">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="hide_background_fanart" type="boolean" label="Ocultar fanart de fundo">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="animate_background_fanart" type="boolean" label="Animar fanart de fundo">
          <level>0</level>
          <default>false</default>
