    <remote>
      <back>Stop</back>
      <stop>Stop</stop>
    </remote>
    <gamepad>
      <B>Stop</B>
      <back>Stop</back>
      <X>Stop</X>
    </gamepad>
  </Visualisation>
  <VideoOSD>
    <keyboard>
      <stop>Stop</stop>
      <x>Stop</x>
    </keyboard>
    <remote>
      <stop>Stop</stop>
    </remote>
    <gamepad>
