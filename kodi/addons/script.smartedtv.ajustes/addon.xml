<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.smartedtv.ajustes" name="SMARTEDTV Ajustes" version="1.0.0" provider-name="SMARTEDTV">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="service.smarted.bootstrap" version="1.0.0" optional="true"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <!-- Atalho permanente da Home: plugin://script.smartedtv.ajustes/?acao=...
         (o plugin.video.smarted do APK vem do APK estável, então quem hospeda
         o menu é este add-on, que é copiado do repositório) -->
    <extension point="xbmc.python.pluginsource" library="vipmenu.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="pt_BR">Ajustes da SMARTEDTV: sem anúncios (VIP) e compartilhar</summary>
        <description lang="pt_BR">Abre o menu da SMARTEDTV com a opção de assistir sem anúncios (VIP), ativação por código e compartilhamento do aplicativo.</description>
        <license>GPL-2.0-or-later</license>
    </extension>
</addon>
