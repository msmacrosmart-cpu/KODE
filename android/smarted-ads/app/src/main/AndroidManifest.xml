<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- exigido pelo AdMob no Android 13+ (ID de publicidade) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- roda em TV Box / projetor: toque nao e obligatorio -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.leanback" android:required="false" />

    <!-- Android 11+ (API 30) filtra a visibilidade entre apps. O Kodi abre estas
         telas por componente explicito (className), que nao depende de <queries>;
         a declaracao abaixo serve para este app conseguir consultar o Kodi
         (ex.: checar versao/instalacao em diagnostico). -->
    <queries>
        <package android:name="org.xbmc.kodi" />
    </queries>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@android:drawable/ic_media_play"
        android:label="SMARTEDTV Anuncios"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- APPLICATION_ID real do AdMob. Sem esta meta-data o SDK nao sobe. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2066014755407744~5076693043" />

        <!-- Os dois anuncios sao abertos pelo Kodi com StartAndroidActivity():
             activity exportada e sem filtro de intent (componente explicito). -->
        <activity
            android:name="org.smartedtv.ads.AppOpenActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <activity
            android:name="org.smartedtv.ads.PreRollActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
